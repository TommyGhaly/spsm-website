{
  "indexes": [
    {
      "comment": "Public calendar: upcoming published events, soonest first.",
      "collectionGroup": "events",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "published",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "startAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "Category filter on the calendar.",
      "collectionGroup": "events",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "published",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "category",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "startAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "Homepage announcements: pinned first, then newest.",
      "collectionGroup": "announcements",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "published",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "pinned",
          "order": "DESCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Prayer wall: active public requests, newest first.",
      "collectionGroup": "prayerRequests",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "visibility",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Member order history.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "memberUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Bookstore fulfillment queue.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "fulfillment",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "Staff plate lookup during an event. Plate is pre-normalized.",
      "collectionGroup": "vehicles",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "plate",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "active",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "Staff tooling: every page in a section, published or not. Staff reads are not constrained to published==true, so this index has no published field.",
      "collectionGroup": "content",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "section",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "order",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "Public section pages. The published filter is mandatory for anonymous reads (see firestore.rules), so it must be in the index \u2014 the staff index above cannot serve this query.",
      "collectionGroup": "content",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "published",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "section",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "order",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "All published content pages across sections, for whole-site nav generation.",
      "collectionGroup": "content",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "published",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "order",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "Program galleries. These matter more than most: the gallery pages are client-rendered at request time, so a missing index is not a failed build a developer sees \u2014 it is a live page that spins forever for a visitor. Every entry below mirrors a query in apps/website/src/features/programs.",
      "collectionGroup": "programs",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "published",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "order",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "The events under one program, newest first. Undated events sort last by convention, not by this index.",
      "collectionGroup": "programEvents",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "programId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "published",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "startAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Admin: every event under a program, published or not. Cannot be served by the public index above, which requires the published filter.",
      "collectionGroup": "programEvents",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "programId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "startAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "One gallery. The status filter is mandatory for public reads \u2014 firestore.rules denies the query outright without it, not merely the rows \u2014 so it is part of every public index here.",
      "collectionGroup": "galleryMedia",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "programEventId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "order",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "One group within a gallery, and the presentation running a single day.",
      "collectionGroup": "galleryMedia",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "programEventId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "groupId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "order",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "Presentation across a whole program, and the program card's cover photo.",
      "collectionGroup": "galleryMedia",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "programId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "order",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "The approval queue, scoped to one program. A program-scoped administrator MUST filter on programId \u2014 the rules cannot prove their grant covers an unfiltered list, so the query is denied rather than trimmed.",
      "collectionGroup": "galleryMedia",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "programId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "submittedAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "The approval queue for one event, which is what an event-scoped volunteer sees.",
      "collectionGroup": "galleryMedia",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "programEventId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "submittedAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "The homepage preview band: showcase photographs from every program at once. Placement is a nested map, hence the dotted path.",
      "collectionGroup": "galleryMedia",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "placement.homepage",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "order",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "collectionGroup": "galleryMedia",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "submittedAt",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
