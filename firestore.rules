rules_version = '2';

// Authorization lives here, not in the UI. Anything the client hides is a
// convenience; anything this file allows is the actual policy.
//
// Three answers, matching packages/shared/src/claims.ts:
//
//   signed in    the servants' rota, and nothing else. Sign-in is Microsoft-only
//                and restricted to the parish's Entra tenant, so authenticating
//                at all already means being a servant of this church.
//   allocated    `screenAdmin` and `programAdmin` on the member document, handed
//                out at /access. This is where every other privilege comes from.
//   superadmin   one boolean claim. Opens everything, including the allocating.
//
// The role ladder (`member < servant < staff < admin`) and the `groups` claims
// (`clergy`, `bookstore`, `parking`) are gone. Every `hasRole('staff')` in this
// file became the specific `hasScreen(...)` for the thing it was guarding, and
// every `inGroup('bookstore')`/`inGroup('parking')` collapsed into the screen
// flag that sat beside it — the two already named the same people.
//
// `superadmin` comes from the ID token and can, because it is set once from a
// terminal. The allocation comes from the member document and must, because a
// grant that waited an hour for a token refresh would be reported as broken
// every time it was used. That the document is safe to read is a property of
// `match /members/{uid}` below, which pins both maps against self-writes.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- claim helpers -----------------------------------------------------

    function claims() {
      return request.auth != null ? request.auth.token : {};
    }

    /*
     * The parish's site administrator, and the only claim that decides anything.
     *
     * `get('superadmin', false)` rather than a bare read: a token minted before
     * this claim existed simply does not have the key, and a missing key in a
     * rules map is an error rather than a falsy value. Every account signed in
     * on the old model is in exactly that state until its token next refreshes.
     */
    function isSuper() {
      return request.auth != null && claims().get('superadmin', false) == true;
    }

    function signedIn() {
      return request.auth != null;
    }

    /*
     * A person in the church directory, as opposed to *any* authenticated
     * request.
     *
     * `signedIn()` stopped meaning the first thing on 2026-09-04, when the
     * Anonymous provider was enabled on the project so that parishioners
     * without accounts could send photographs to the galleries
     * (`lib/uploadSession.ts`, docs/gallery-console-setup.md §6). Before that
     * the two were the same by accident: sign-in was Microsoft-only, so the
     * only way to hold a token was to be in the parish's Entra tenant, and a
     * rule could say `signedIn()` and mean "on the rota".
     *
     * It cannot any more. Anyone can mint an anonymous uid from a console with
     * the web API key, which is in the public bundle by design — so every bare
     * `signedIn()` read rule became a world-readable one the moment that switch
     * was flipped. `/servantEvents` was the one that mattered and it said so
     * itself; see the note there.
     *
     * `.get()` twice rather than `token.firebase.sign_in_provider`, because a
     * missing key in a rules map is an error rather than a falsy value, and a
     * rule that errors denies. Every real ID token carries `firebase`, but a
     * rule this load-bearing should not be the place that assumes it.
     *
     * Costs nothing: it reads the caller's own token and never Firestore.
     */
    function isPerson() {
      return signedIn()
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- per-screen grants -------------------------------------------------

    /*
     * The `screenAdmin` map on the caller's member document.
     *
     * **This is now the whole of the site's authorization**, alongside
     * `programAdmin` below and the one `superadmin` claim above. It used to be a
     * third axis widening a `staff` tier that admitted everybody who held it;
     * with the tier gone, a flag is not a widening of anything — it is the door.
     *
     * On the member document rather than in the token because a grant that
     * changes must not wait up to an hour for a token to refresh. An
     * administrator hands somebody the bookstore and they have it on their next
     * page load, not after they sign out and back in. That is worth one billed
     * `get()` per check, which is the same bargain `adminsProgram()` makes.
     *
     * `exists()` first, for the same reason `memberGrants()` does it: the first
     * administrator is bootstrapped by `grant-admin.mjs` and may have no member
     * document at all. A `get()` on a missing document is an evaluation error,
     * and an error denies — which would have locked out the one account that
     * can fix it.
     */
    function memberScreens() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('screenAdmin', {})
        : {};
    }

    /*
     * Whether the caller has been entrusted with one area of the site.
     *
     * `signedIn()` first so an unauthenticated request short-circuits before
     * touching `request.auth.uid`, which would otherwise be an evaluation error
     * on every anonymous read of a collection that calls this.
     */
    function screenFlag(screen) {
      return signedIn() && memberScreens().get(screen, false) == true;
    }

    /*
     * Read every use of this as "the superadmin, or the person given this area".
     *
     * `isSuper()` is checked first so the administrator never pays for the
     * member lookup — and so the first account, bootstrapped by
     * `grant-admin.mjs` before it has a member document, is not refused by a
     * `get()` on a document that does not exist.
     *
     * There was a second helper here, `hasStrictScreen()`, for rules that were
     * `admin` rather than `staff` — the design tokens, in practice. It existed
     * only to stop a flag from admitting the whole `staff` tier as a side
     * effect. With no tier left the two are the same function, so there is one.
     */
    function hasScreen(screen) {
      return isSuper() || screenFlag(screen);
    }

    /*
     * The `financeScopes` map — which parts of the church's money one grant reaches.
     *
     * `finance` is one flag onto three sources: the shop's takings, the camp's
     * fees and the paid forms. A parish that wants the bookkeeper to see the
     * shop and not the camp had no way to say so, because a flag is a boolean.
     * This map is that sentence, and it only ever *narrows* — `hasFinance()`
     * below asks `hasScreen('finance')` first, so a source ticked for somebody
     * without the finance grant opens nothing at all.
     *
     * Same `exists()` guard as `memberScreens()`, for the same reason: a `get()`
     * on a missing document is an evaluation error, and an error denies.
     */
    function memberFinanceScopes() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('financeScopes', {})
        : {};
    }

    /*
     * Whether the caller may see one source of money.
     *
     * **An absent map means all three**, which is the opposite of how
     * `screenFlag()` treats a missing key and is deliberate. Every member
     * document written before this map existed belongs to somebody granted
     * `finance` when `finance` meant all three; reading their absent map as
     * "nothing" would silently revoke every treasurer in the parish on the day
     * this deployed. The safe direction for a *narrowing* is "not yet narrowed".
     *
     * `keys().hasAny([...])` and not `keys().size() == 0` is what keeps that
     * from swallowing a real choice: /access always writes all three keys, so an
     * administrator who unticks everything stores three explicit `false`s, which
     * names a source and is therefore honoured exactly.
     * `parseFinanceScopes` in packages/shared/src/screens.ts is this function in
     * TypeScript, and the two must stay in step.
     */
    function hasFinance(source) {
      return isSuper()
        || (screenFlag('finance')
            && (!memberFinanceScopes().keys().hasAny(['bookstore', 'camp', 'forms'])
                || memberFinanceScopes().get(source, false) == true));
    }

    // Cloud Functions use the Admin SDK, which bypasses these rules entirely.
    // So "no client may write X" below still leaves X writable by our backend.

    // ---- helpers for content ----------------------------------------------

    // `published` is the whole switch. `publishAt` is deliberately NOT read
    // here, and that is load-bearing rather than an omission.
    //
    // This rule used to be:
    //   doc.published == true && (doc.publishAt == null || doc.publishAt <= request.time)
    //
    // It compiled, and `npm run rules:check` passed, and it denied every public
    // list query in existence. Firestore evaluates a `list` against the query's
    // *potential* result set, not the documents actually returned — so it has
    // to prove from the query constraints alone that no disallowed document
    // could come back. `where('published','==',true)` proves the first clause
    // and says nothing about the second, so the whole query is rejected.
    //
    // Measured against the live project, empty collection:
    //   where('published','==',true)                          -> permission-denied
    //   where('published','==',true), where('publishAt','==',null) -> allowed
    //
    // That second line is the trap. It is the only query the old rule admitted,
    // and it silently excludes every document that has a publishAt — including
    // after that time has passed. Scheduled content would never appear, and
    // nothing would error.
    //
    // So scheduling moved to where it can actually work: `publishAt` is an
    // instruction to a scheduled Cloud Function, which flips `published` to
    // true when the time arrives. That is required anyway — the public site is
    // a static export, so a page going live means a rebuild, and no read-time
    // rule can trigger one. See docs/decisions.md #10.
    function isPublished(doc) {
      return doc.published == true;
    }

    // ---- public content ---------------------------------------------------
    // Readable by the world (the static export reads these at build time and
    // the PWA caches them offline). Writable only by staff.

    match /content/{pageId} {
      // The About pages and the other prose documents. `hasScreen` widens this
      // from staff-only to "staff, or whoever was given Content at /access" —
      // which is the whole point of that screen: somebody who writes the parish's
      // copy should not need the role that also opens the bookstore's takings.
      allow read: if isPublished(resource.data) || hasScreen('content');
      allow write: if hasScreen('content');
    }

    // Staff's edits to the five About pages, and to /privacy.
    //
    // Read by the world, and that is not a widening of anything — it is the
    // copy on a public page. Three readers: `next build` reading it
    // unauthenticated to bake the pages, every visitor's browser re-reading it
    // over REST a moment after load to pick up an edit made since that build,
    // and the editor itself.
    //
    // No `published` field, and none is wanted. `getAboutOverride` fetches this
    // document **by id** and nothing ever lists the collection, so there is no
    // query whose potential result set has to be proved — the trap in
    // docs/decisions.md #10 cannot apply here. If something ever does list it,
    // that reader needs a filter and this comment needs deleting.
    //
    // The `slug in [...]` clause is where "the editable pages are a closed list"
    // actually lives. A new one needs a route file for the static export to
    // enumerate (see features/content/about.ts) and a band manifest in
    // features/about/slots.ts, so a document alone would only produce copy
    // nothing renders; refusing it here means the editor cannot create one by
    // accident. Keep this list and `ABOUT_SLUGS` identical — add a slug in both
    // places or in neither.
    //
    // `privacy` is on the list and is not part of About: /privacy is edited by
    // the same overlay, under the same `content` flag, because it is the same
    // shape of page. See the note on `ABOUT_SLUGS` in schema/about.ts.
    //
    // Delete is closed outright. Clearing every field already restores the
    // hand-written page — that is what `copyOf` and `pictureOf` are for — so a
    // delete buys nothing and costs the audit trail.
    match /aboutOverrides/{slug} {
      allow read: if true;
      allow create, update: if hasScreen('content')
        && request.resource.data.slug == slug
        && slug in [
          'who-we-are',
          'our-belief',
          'patron-saints',
          'welcome-newcomers',
          'future-plans',
          'privacy',
        ];
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      // The `bulletin` grant. Note there is no editor for these today — the
      // week's bulletin is read through from the parish's own source and never
      // mirrored here — so this currently widens a door nothing walks through.
      // Wired anyway: a flag the rules ignore is the exact bug this whole axis
      // was just fixed for, and leaving one behind reintroduces it.
      allow read: if isPublished(resource.data) || hasScreen('bulletin');
      allow write: if hasScreen('bulletin');
    }

    // ---- runtime configuration --------------------------------------------
    // Integration endpoints and feature switches that staff change without a
    // deploy. See packages/shared/src/schema/config.ts.
    //
    // World-readable, deliberately: the website build reads this as an
    // anonymous client before it has any other credential, so there is no
    // identity to gate on. That is only acceptable because of what lives here —
    // a project id and a collection name authorize nothing, and access to the
    // other project is controlled by its IAM, not by the obscurity of its name.
    //
    // ANYTHING WRITTEN HERE IS PUBLIC. No service-account keys, no API tokens,
    // no webhook signing secrets. Those belong in Secret Manager.
    match /config/{docId} {
      allow read: if true;
      // Superadmin only, and not delegable — `config` is in ADMIN_SCREENS and
      // /access deliberately does not offer the row. This is where the site is
      // pointed at its backends; see packages/shared/src/screens.ts.
      allow write: if isSuper();
    }

    /*
     * The shop's divisions, writable by the people who run the shop.
     *
     * -----------------------------------------------------------------------
     * A second match on a path the rule above already covers. Firestore grants
     * if **any** matching rule allows, so this can only widen `config/{docId}` —
     * it cannot narrow it, and nothing here tries to.
     *
     * A near-identical block existed briefly to support an in-place settings
     * editor, and was removed with that editor because an open write path kept
     * for a caller that no longer exists is pure attack surface. It is back for
     * a caller that does exist: the section editor in the admin drawer. The
     * difference is the key set — `sections`, and since live postage
     * `shipping`, whose shape is checked by `isShippingSettings`. The delivery charge, the
     * order email and the two pieces of shop copy are **not** writable here and
     * remain admin-only through the rule above, because nothing in a browser
     * writes them.
     *
     * `config` is world-readable, so a writer cannot leak anything they could
     * not already read; the risk is a malformed document breaking the shop, and
     * the shape check below is what bounds that. Twelve sections, forty
     * characters of label. `parseSections` drops anything that gets through.
     * -----------------------------------------------------------------------
     */
    /*
     * The design tokens, carved out of the `config` block above so the `theme`
     * grant can reach them.
     *
     * This was `hasStrictScreen()` while a `staff` tier existed, so that
     * honouring the flag did not hand the whole staff a door that had always
     * needed a superadmin. There is no tier now and the two helpers collapsed
     * into one — but the caution is still the reason this document is carved
     * out at all: `theme` restyles every page on the site, so it is a grant
     * given to one person on purpose rather than to whoever edits the About
     * pages.
     *
     * Read stays public because `config` above is public and a narrower rule
     * cannot claw that back — Firestore grants when any matching rule allows.
     * That is fine here and load-bearing elsewhere: the tokens are painted by
     * every visitor's browser, so they have to be world-readable anyway.
     */
    /*
     * The camp's own settings, writable by the people who run the camp.
     *
     * -----------------------------------------------------------------------
     * A second match on a path `config/{docId}` already covers, exactly like
     * the shop's `sections` block above. Firestore grants if **any** matching
     * rule allows, so this can only widen.
     *
     * It widened on 2 Sep 2026, from the single `servantSignUp` boolean to
     * everything on the document **except `programId`**, and the exception is
     * the whole rule. Every other key — the season, the week dates, the fee, the
     * waiver, the two form switches — is a decision *about running this camp*,
     * made by whoever is running it, several times a season.
     *
     * `programId` used to name the ministry whose grant *was* the camp grant, so
     * writing it was a way to hand yourself somebody else's camp. It no longer
     * decides who gets in — `runsCamp()` is a screen flag — and it stays refused
     * for what it still does: it is the ministry the camp's registrations are
     * filed under and the gallery its photographs go to, so a camp
     * administrator who could write it could re-point the camp at a ministry
     * they were given for its pictures, or at one that is not theirs at all.
     *
     * The argument for keeping the fee and the waiver shut was that both change
     * what a family is charged or what they agreed to. True, and it is the camp
     * that sets both: routing them through the one person holding `superadmin`
     * made the fee a support request in the week registrations open, which is
     * how a camp ends up taking money at last year's price. `waiverVersion`
     * sits beside `waiverText` for the same reason — a text change nobody may
     * version is worse than one they may.
     *
     * `resource.data.programId` and not the incoming one, so this cannot be
     * used to move the camp to a ministry the writer happens to administer,
     * and `hasOnly` refuses a write that adds a key nothing here has vouched
     * for.
     * -----------------------------------------------------------------------
     */
    match /config/camp {
      allow read: if true;
      allow update: if runsCamp()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'season', 'baseCents', 'servantChargeCents', 'servantChargeLabel',
             'weeks', 'weekStarts', 'weekRoles',
             'waiverVersion', 'waiverText', 'note',
             'servantSignUp', 'familyRegistration',
             'updatedAt', 'updatedBy',
           ])
        // Attributable, like every other write on this site. `updatedBy` is
        // optional only because the switches were written without it before
        // this rule existed and a settings document already carrying somebody
        // else's uid must still be editable.
        && (!('updatedBy' in request.resource.data.diff(resource.data).affectedKeys())
             || request.resource.data.updatedBy == request.auth.uid)
        // The types rules can actually see. `weeks` is bounded because a
        // mistyped 400 draws four hundred day checkboxes on the form, and
        // `baseCents` because a mistyped fee is money.
        && (!('season' in request.resource.data) || request.resource.data.season is string)
        && (!('baseCents' in request.resource.data)
             || (request.resource.data.baseCents is int
                 && request.resource.data.baseCents >= 0
                 && request.resource.data.baseCents <= 200000))
        // The servants' flat charge — the shirt money. Bounded for the same
        // reason `baseCents` is, and harder: this one is taken from a stranger
        // by an unauthenticated endpoint the moment they press send, so a
        // mistyped figure is money off somebody's card rather than a wrong
        // number read aloud at a desk.
        && (!('servantChargeCents' in request.resource.data)
             || (request.resource.data.servantChargeCents is int
                 && request.resource.data.servantChargeCents >= 0
                 && request.resource.data.servantChargeCents <= 200000))
        && (!('servantChargeLabel' in request.resource.data)
             || request.resource.data.servantChargeLabel is string)
        && (!('weeks' in request.resource.data)
             || (request.resource.data.weeks is int
                 && request.resource.data.weeks >= 1
                 && request.resource.data.weeks <= 6))
        && (!('weekStarts' in request.resource.data)
             || (request.resource.data.weekStarts is list
                 && request.resource.data.weekStarts.size() <= 6))
        // What a servant may ask to do, one list per week per section, keyed
        // `w1_elementary`. A map and not a list of lists because Firestore has
        // no array of arrays — see `CampConfig.weekRoles`. The panel writes one
        // week and one half of the camp at a time (`weekRoles.w2_middle`),
        // which still reads as this one affected key.
        //
        // Eighteen: six weeks times the camp's two halves, plus the six bare
        // `w1` keys written before the halves were told apart, which are read
        // but never written and must not make a document unsaveable.
        && (!('weekRoles' in request.resource.data)
             || (request.resource.data.weekRoles is map
                 && request.resource.data.weekRoles.keys().size() <= 18))
        && (!('servantSignUp' in request.resource.data)
             || request.resource.data.servantSignUp is bool)
        && (!('familyRegistration' in request.resource.data)
             || request.resource.data.familyRegistration is bool);
    }

    match /config/theme {
      allow read: if true;
      allow write: if hasScreen('theme');
    }

    match /config/bookstore {
      allow read: if true;

      /*
       * Create and update are separate, and that is not tidiness.
       *
       * `request.resource.data.diff(resource.data)` needs `resource` to exist.
       * Nothing seeds `config/bookstore` — the defaults live in the shared
       * package and the document is written the first time somebody changes
       * something — so on a parish that has never touched it, `resource` is
       * null, `diff` fails, and the *first* section anyone tries to make is
       * refused with nothing to explain it. The create branch checks the whole
       * key set instead, which is the same guarantee without the dereference.
       */
      allow create: if hasScreen('bookstore')
        && request.resource.data.keys().hasOnly(['sections', 'shipping', 'updatedAt', 'updatedBy'])
        && (!('sections' in request.resource.data) || isSectionList(request.resource.data.sections))
        && (!('shipping' in request.resource.data) || isShippingSettings(request.resource.data.shipping))
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if hasScreen('bookstore')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['sections', 'shipping', 'updatedAt', 'updatedBy'])
        && (!('sections' in request.resource.data) || isSectionList(request.resource.data.sections))
        && (!('shipping' in request.resource.data) || isShippingSettings(request.resource.data.shipping))
        && request.resource.data.updatedBy == request.auth.uid;

      // Never. The shop's divisions going missing wholesale is not an edit.
      allow delete: if false;
    }

    function isSectionList(sections) {
      return sections is list && sections.size() <= 12;
    }

    /*
     * Live postage settings. Shape and bounds only — `parseShipping` falls any
     * out-of-range field back to its default, so this is the guard against a
     * document that is the wrong *kind* of thing, and against a handling fee
     * with a stray zero. Matches MAX_HANDLING_CENTS and MAX_BOX_* in
     * packages/shared/src/schema/config.ts.
     */
    function isShippingSettings(shipping) {
      return shipping is map
        && shipping.keys().hasOnly(['mode', 'originZip', 'handlingCents', 'box', 'services'])
        && shipping.mode in ['usps', 'flat']
        && shipping.originZip is string && shipping.originZip.matches('[0-9]{5}')
        && shipping.handlingCents is int && shipping.handlingCents >= 0 && shipping.handlingCents <= 2000
        && shipping.box is map
        && shipping.box.keys().hasOnly(['lengthIn', 'widthIn', 'heightIn', 'tareOz'])
        && shipping.box.lengthIn is number && shipping.box.lengthIn > 0 && shipping.box.lengthIn <= 36
        && shipping.box.widthIn is number && shipping.box.widthIn > 0 && shipping.box.widthIn <= 36
        && shipping.box.heightIn is number && shipping.box.heightIn > 0 && shipping.box.heightIn <= 36
        && shipping.box.tareOz is number && shipping.box.tareOz >= 0 && shipping.box.tareOz <= 80
        && shipping.services is list && shipping.services.size() <= 3
        && shipping.services.hasOnly(['USPS_GROUND_ADVANTAGE', 'PRIORITY_MAIL', 'MEDIA_MAIL']);
    }

    /*
     * The forms hub's two settings, writable by the people who keep the forms.
     *
     * -----------------------------------------------------------------------
     * Another carve-out of `config/{docId}`, which is superadmin-only above.
     * Firestore grants if any rule allows, so this widens that one document and
     * nothing else — and it widens it to exactly the grant that already decides
     * every other thing about this page: whoever may build a form may say which
     * one a tap lands on, and where the summer camp sits in the list.
     *
     * Neither value authorizes anything. `nfcFormSlug` names a form that is
     * public the moment it is published, and `campOrder` is a position in a
     * list — so the worst a bad write can do is send a tap to the wrong parish
     * form, which is a thing the same person can already do by editing the form
     * itself. `parseFormsPageConfig` bounds both on the way out.
     *
     * Create and update are separate for the reason `config/bookstore` states:
     * nothing seeds this document, so on a parish that has never touched it
     * `resource` is null and `diff` cannot be dereferenced.
     * -----------------------------------------------------------------------
     */
    match /config/forms {
      allow read: if true;

      allow create: if hasScreen('forms')
        && request.resource.data.keys().hasOnly(
             ['nfcFormSlug', 'campOrder', 'updatedAt', 'updatedBy'])
        && isFormsPageConfig(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if hasScreen('forms')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['nfcFormSlug', 'campOrder', 'updatedAt', 'updatedBy'])
        && isFormsPageConfig(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      // Never. The tag's destination going missing wholesale is not an edit —
      // and a reader that finds no document falls back to the vehicle
      // registration, which is not what a delete would have meant.
      allow delete: if false;
    }

    function isFormsPageConfig(data) {
      return (!('nfcFormSlug' in data)
               || (data.nfcFormSlug is string && data.nfcFormSlug.size() <= 120))
        && (!('campOrder' in data)
             || (data.campOrder is int && data.campOrder >= 0 && data.campOrder <= 100000));
    }

    match /events/{eventId} {
      // Parish calendar. Servant-only entries live in /servantEvents so this
      // stays a path check rather than a per-doc audience filter — a filter
      // would leak titles through list queries if anyone forgot a where().
      //
      // ---------------------------------------------------------------------
      // WORLD-READABLE, and that is a deliberate change rather than a slip.
      //
      // This was `isPublished(resource.data) || hasRole('staff')`, which kept
      // unpublished events staff-only. The `published` field is gone: at Tommy's
      // direction the events editor has no publish step at all — typing saves,
      // and an event exists or it does not. There is no longer any such thing as
      // an event that is in the collection but not on the website, so there is
      // nothing for a read rule to distinguish.
      //
      // Two things follow, and both are consequences of that decision rather
      // than of this line:
      //
      //  - **The rule had to change or the site would go blank.** `data.ts` reads
      //    this collection *anonymously* at build time. With `published` absent,
      //    `isPublished(resource.data)` is false for every document, so the old
      //    rule would have denied the build's read and every event would have
      //    disappeared from the site at the next deploy.
      //  - **Anything left in the collection is public.** An event nobody wants
      //    seen has to be deleted, not hidden. That is the model now.
      //
      // Servant-only entries are unaffected: they are in /servantEvents below,
      // which is a different path with a different rule, and always were.
      // ---------------------------------------------------------------------
      allow read: if true;
      // The parish calendar, and only that. Somebody given Events at /access
      // can add and edit the services and one-off event pages; the ministries
      // and their photographs are a different axis entirely — `programAdmin`,
      // enforced by `adminsProgram()` further down. The two are deliberately
      // not one flag: handing the youth servant every Summercamp gathering must
      // not also hand them the liturgy schedule.
      allow write: if hasScreen('events');
    }

    match /servantEvents/{eventId} {
      /*
       * The one thing signing in is worth on its own.
       *
       * This is the schedule every servant is on, and needing an allocation to
       * see when you are serving would be the wrong way round — so the check is
       * `isPerson()` and nothing more. It reads as generous and is not: an
       * account here is a Microsoft account, and `enforceTenantOnCreate` refuses
       * any that is outside the parish's Entra directory — so the set of people
       * this admits is the set of people on the rota.
       *
       * That property is the whole security model of this line, and it has
       * already been broken once. **This said `signedIn()` until 2026-09-04**,
       * which was the same thing right up until the Anonymous provider was
       * enabled for gallery uploads — and anyone can mint an anonymous uid with
       * the web API key out of the public bundle. For as long as those two
       * facts coexisted, this collection was world-readable: the rota, with
       * every servant's name and every date they are down for, to anybody who
       * opened a console. The switch and this rule have to move together, and
       * the rule has to move first.
       *
       * The single-tenant warning still stands alongside it: **if the Entra app
       * registration is ever switched to multi-tenant, this collection becomes
       * readable by every Microsoft account in the world.** `isPerson()` does
       * not help with that one — it only excludes anonymous sessions, and a
       * multi-tenant account is a real sign-in.
       *
       * Writing it is still the `servants` grant.
       */
      allow read: if isPerson();
      allow write: if hasScreen('servants');
    }

    // ---- the calendar's two staff-writable layers -------------------------
    //
    // Both are world-readable because both are part of the public schedule:
    // /calendar assembles them in the browser alongside Breeze, so an
    // anonymous visitor has to be able to read them or a manually added
    // service is invisible to everyone except staff.
    //
    // Two collections rather than one, and the split is what makes the rule
    // "staff may only remove what staff added" enforceable rather than merely
    // intended — see packages/shared/src/schema/scheduleAdmin.ts. There is no
    // path here that can delete a liturgy, because a liturgy is not in either
    // of these; it is in Breeze, and deleting it from the website would only
    // make the website disagree with Breeze until the next read put it back.

    // Something the parish is doing that no source knows about. Ours, so it can
    // be created, edited and deleted.
    match /scheduleEntries/{entryId} {
      allow read: if true;
      // `events`, not `servants`, and the distinction is the one ADMIN_SCREENS
      // draws: these two layers are the *public* schedule on /calendar, which is
      // the same thing the `events` grant covers. The servants' own rota is
      // /servantEvents above and is a different grant.
      allow write: if hasScreen('events');
    }

    // An annotation on an occurrence that already exists. Creating or deleting
    // one never creates or deletes the event it is about.
    match /calendarDetails/{occurrenceId} {
      allow read: if true;
      allow write: if hasScreen('events');
    }

    // The two Breeze calendar embed URLs, and nothing else.
    //
    // Not a document under /config, and that is the whole point. `config` is
    // `allow read: if true`, and a narrower rule cannot take that back —
    // Firestore grants when ANY matching rule allows, so `config/servants`
    // would be world-readable no matter what was written here. A separate
    // collection is the only way to gate it.
    //
    // It has to be gated because an embed URL is itself the credential: Breeze
    // serves the calendar to anyone who requests that URL, with no session and
    // no referrer check.
    //
    // -----------------------------------------------------------------------
    // `read: if false` — nobody, not even a servant. This was `hasRole('servant')`,
    // back when there were roles at all.
    //
    // It was that because the browser used to fetch the URL after sign-in and
    // frame it in an iframe, which meant every servant's tab held a credential
    // they could copy and pass on, permanently and undetectably.
    //
    // Nothing reads this from a client any more. The `calendar` Cloud Function
    // reads it through the Admin SDK — which bypasses rules entirely, so this
    // line does not constrain it — calls Breeze, and returns the *events*. A
    // servant now gets a week of JSON checked against their ID token instead of
    // a bearer URL, so there is no longer any client that needs this document,
    // and a rule granting access nobody uses is a rule that will be used by
    // accident.
    //
    // `scripts/set-servants-schedule.mjs` writes it over the REST API with
    // gcloud credentials, which bypass rules the same way. So does the emulator
    // seed. The write rule stays as documentation of intent.
    // -----------------------------------------------------------------------
    match /servantsConfig/{docId} {
      allow read: if false;
      allow write: if isSuper();
    }

    // ---- members ----------------------------------------------------------

    match /members/{uid} {
      /*
       * Your own profile, or the superadmin's.
       *
       * This was `isSelf(uid) || hasRole('staff')`, which let the whole
       * administrative tier read everybody's phone number and email. The only
       * caller that ever wanted somebody *else's* document is the allocation
       * list at /access, which is superadmin-only — every other read in the
       * codebase is a person reading their own grants. So the rule is now the
       * two callers that exist.
       *
       * Note the `members` flag in ADMIN_SCREENS is deliberately not honoured
       * here. It is the power to grant every other flag, and delegating the
       * delegation is how a superadmin-only screen quietly stops being one.
       */
      allow read: if isSelf(uid) || isSuper();

      // A member may edit their own profile but may NOT touch `superadminMirror`
      // — a display copy of the claim, written by `grant-admin.mjs` — nor
      // `screenAdmin` and `programAdmin`, which are permissions and not
      // preferences.
      //
      // The two maps matter far more than the mirror they sit beside. The
      // mirror is cosmetic: rules read the token, so a forged
      // `superadminMirror` grants nothing. `screenAdmin` has no claim behind it
      // — it is the *only* record of which areas somebody may manage — so a
      // member who could write it could open every admin screen on the site to
      // themselves. Hence it is pinned on create as well as update.
      allow create: if isSelf(uid)
        && request.resource.data.get('superadminMirror', false) == false
        && (!('screenAdmin' in request.resource.data)
            || !request.resource.data.screenAdmin.values().hasAny([true]))
        // `financeScopes` narrows the `finance` grant, and an absent map means
        // all three sources — so a member seeding one here could not widen
        // anything they had not already been given, but they could not narrow
        // it either, and a permission map a member writes at all is one this
        // file then reads. Pinned to absent on create, like the two below.
        && !('financeScopes' in request.resource.data)
        // `programAdmin` is the same kind of thing as `screenAdmin` and is
        // pinned for the same reason — but it is read by the gallery rules
        // below via `get()`, which makes it the one permission on this site
        // that a self-written member document could actually exercise. A
        // member who could seed it on create would own every program.
        && (!('programAdmin' in request.resource.data)
            || (request.resource.data.programAdmin.get('programs', []).size() == 0
                && request.resource.data.programAdmin.get('events', []).size() == 0));

      allow update: if isSelf(uid)
        && request.resource.data.get('superadminMirror', false)
             == resource.data.get('superadminMirror', false)
        // Byte-for-byte identical, rather than "no true values". A member must
        // not be able to revoke their own grants either — a support call about
        // access that silently disappeared is worse than one about access that
        // was never given.
        && request.resource.data.get('screenAdmin', {}) == resource.data.get('screenAdmin', {})
        && request.resource.data.get('programAdmin', {}) == resource.data.get('programAdmin', {})
        // The third permission map, pinned the same way. A treasurer narrowed
        // to the camp could otherwise hand themselves the shop's orders by
        // editing their own profile — `financeScopes` is read by `hasFinance()`
        // exactly as `screenAdmin` is read by `screenFlag()`.
        && request.resource.data.get('financeScopes', {}) == resource.data.get('financeScopes', {});

      allow update: if isSuper();
      allow delete: if isSuper();
    }

    match /products/{productId} {
      allow read: if isPublished(resource.data);
      allow read: if hasScreen('bookstore');

      /*
       * The one field a browser may change: which part of the shop a product
       * appears in. There is no broad `allow write` here, and its removal is
       * the one place in this file where collapsing the role ladder made a rule
       * *narrower* rather than merely renaming it.
       *
       * It used to read `allow write: if hasRole('staff')` beside this block.
       * Firestore ORs matching rules, so that broad line meant every check
       * below was skipped for anybody staff — the bounded key set governed the
       * `inGroup('bookstore')` volunteer and nobody else, and the suite once
       * caught `section: 42` succeeding from a staff account for exactly that
       * reason. Collapsing the group into the flag would have promoted every
       * shop volunteer through the broad line and left this block dead: a
       * browser holding the Bookstore grant could rewrite every price in the
       * catalogue.
       *
       * So the broad line went instead. Nothing needs it. The only browser
       * writes to this collection are `setProductSection` and
       * `setProductShipping` in features/bookstore/adminData.ts, and everything else — the Square
       * mirror, the 15-minute refresh — runs through the Admin SDK, which
       * bypasses this file entirely. Square owns the price, the name, the stock
       * and whether a book is listed at all; `hasOnly` admits three keys and
       * `section` is the only one that carries meaning.
       *
       * Creating a product is *not* here and must not be. It has to happen in
       * Square first, because the checkout prices orders from Square's catalog —
       * a row invented in Firestore has no variation id and cannot be bought.
       * That path is `squareCreateProduct`, which re-checks the grant
       * server-side.
       */
      /*
       * `weightOz` and `mediaMail` joined `section` with live postage: like it,
       * they are the parish's (Square holds no weights) and only price
       * *delivery*, which the checkout Function quotes from them server-side.
       * A wrong weight costs the parish a few cents of postage either way; it
       * cannot change what a book costs. Bounded at USPS's 70 lb limit.
       */
      allow update: if hasScreen('bookstore')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['section', 'weightOz', 'mediaMail', 'updatedAt', 'updatedBy'])
        && (!('section' in request.resource.data)
            || request.resource.data.section == null
            || (request.resource.data.section is string
                && request.resource.data.section.size() <= 40))
        && (!('weightOz' in request.resource.data)
            || request.resource.data.weightOz == null
            || (request.resource.data.weightOz is number
                && request.resource.data.weightOz > 0
                && request.resource.data.weightOz <= 1120))
        && (!('mediaMail' in request.resource.data)
            || request.resource.data.mediaMail is bool)
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /orders/{orderId} {
      // A member sees their own orders; whoever runs the shop sees all.
      //
      // A buyer is neither. Sign-in here is Microsoft-only and restricted to
      // the parish tenant, so a parishioner has no uid for `isSelf` to match —
      // they reach their orders through the `orderLookup` Function, which
      // authenticates them with a receipt instead. Nothing below grants them
      // anything, and that is correct: the Admin SDK bypasses these rules.
      // The bookstore half of `finance` is admitted here and it is a real
      // widening: an order carries
      // the buyer's name and what they bought. It is allowed because a refund
      // is a transaction the treasurer has to be able to see against the sale
      // it reverses — a takings figure with no orders behind it cannot be
      // reconciled, and reconciling is the job the flag exists for.
      allow read: if isSelf(resource.data.memberUid)
        || hasScreen('bookstore')
        || hasFinance('bookstore');

      // Orders are created and advanced ONLY by Cloud Functions reconciling
      // Square webhooks. If the client could write here, a member could mark
      // their own order paid.
      allow create, delete: if false;

      /*
       * The one exception: whether the books have been handed over.
       *
       * `fulfillment` is the only field a volunteer changes, and it is the only
       * field this admits. Everything about money — `status`, `total`,
       * `refund`, `squarePaymentId` — stays unwritable by any client, because
       * the reason the rest of this block says `false` is that a client able to
       * write `status` is a client able to mark its own order paid. Packing a
       * parcel is not that, and routing it through a Cloud Function would buy
       * nothing but a cold start.
       *
       * `hasOnly` is what makes the sentence above true. Without it a write
       * that sets `fulfillment` may set anything else in the same breath.
       */
      // `bookstore` and not `finance`: marking a parcel collected is running
      // the shop, not reading its books. The treasurer sees this order — the
      // read rule above admits them — and cannot advance it.
      allow update: if hasScreen('bookstore')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fulfillment', 'updatedAt', 'updatedBy'])
        && request.resource.data.fulfillment in ['unfulfilled', 'ready', 'collected']
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // ---- bookstore statistics ---------------------------------------------

    /*
     * One document per view, cart change, and search.
     *
     * -----------------------------------------------------------------------
     * Writable by anyone, readable by nobody, and both halves are load-bearing.
     *
     * Writable because the people being counted are not signed in and never
     * will be: this site has no public authentication at all. There is no
     * identity to gate on, so the gate is the shape of the document instead —
     * every field below is bounded and typed, which is what keeps an open
     * `create` from being an open-ended write.
     *
     * Readable by nobody, which is what makes the open create acceptable. There
     * is no `list` here and no `get`, so the collection cannot be enumerated,
     * cannot be mined, and holds nothing that identifies anyone in the first
     * place — `visitor` is a random string the browser made up about itself.
     * The worst an abuser achieves is a wrong number on a parish dashboard.
     *
     * No update and no delete: an event is a fact about a moment, and a fact
     * that can be edited afterwards is not one. Old rows leave via the TTL
     * policy on `expiresAt`, which is the database's job rather than a client's.
     *
     * This block and packages/shared/src/analytics/bookstoreEvents.ts must
     * agree field for field. A document this rule rejects is invisible — the
     * write fails inside a fire-and-forget batch that swallows errors, and the
     * statistic just stops moving with nothing in any log to say why.
     * -----------------------------------------------------------------------
     */
    match /bookstoreEvents/{eventId} {
      allow read, update, delete: if false;

      allow create: if isBookstoreEvent(request.resource.data);
    }

    /*
     * -----------------------------------------------------------------------
     * `faults` — the app's own crash reporter.
     *
     * Deliberately not Crashlytics. The app's privacy notice promises there is
     * no third-party crash reporter in it, so a fault is one document here, in
     * the church's own database. See packages/shared/src/analytics/faults.ts,
     * which this block must agree with field for field: a document this rule
     * rejects is invisible, because the reporter swallows its own errors by
     * design and nothing anywhere will say why.
     *
     * **Unauthenticated create, and that is the point.** The failure being
     * reported may be the one that stopped sign-in from finishing; a reporter
     * that needs a working app to report a broken one reports nothing. App
     * Check still gates it, so this is reachable only from a real build.
     *
     * **No client may read it, ever.** A stack trace names the screen somebody
     * was on, and a collection of them is a record of who used what and when.
     * Staff read these in the Firebase console, where access is the console's
     * own and is logged. There is deliberately no uid on the document either —
     * see the file above.
     * -----------------------------------------------------------------------
     */
    match /faults/{faultId} {
      allow read, update, delete: if false;

      allow create: if isFault(request.resource.data);
    }

    function isFault(doc) {
      return doc.keys().hasOnly(['message', 'stack', 'source', 'route', 'platform', 'version', 'dev', 'at', 'expiresAt'])
        && doc.keys().hasAll(['message', 'stack', 'source', 'route', 'platform', 'version', 'dev', 'at', 'expiresAt'])
        // FAULT_MESSAGE_MAX / FAULT_STACK_MAX. A stack is allowed to be empty
        // — plenty of thrown values carry none — but never absent.
        && doc.message is string && doc.message.size() > 0 && doc.message.size() <= 500
        && doc.stack is string && doc.stack.size() <= 4000
        && doc.source in ['render', 'handler']
        // A path, never a URL and never a person. Bounded so this cannot be
        // used to store arbitrary text in a collection nobody reads.
        && doc.route is string && doc.route.size() <= 200
        && doc.platform in ['ios', 'android']
        && doc.version is string && doc.version.size() <= 20
        && doc.dev is bool
        && doc.at == request.time
        // FAULT_TTL_DAYS, swept by the TTL policy on expiresAt. Pinned to the
        // server's clock so a wrong phone clock cannot park a document here
        // for a decade.
        && doc.expiresAt is timestamp
        && doc.expiresAt > request.time
        && doc.expiresAt < request.time + duration.value(31, 'd');
    }

    function isBookstoreEvent(doc) {
      return doc.keys().hasOnly(['kind', 'slug', 'term', 'quantity', 'visitor', 'day', 'at', 'expiresAt'])
        && doc.keys().hasAll(['kind', 'slug', 'term', 'quantity', 'visitor', 'day', 'at', 'expiresAt'])
        && doc.kind in ['view', 'detail', 'cartAdd', 'cartRemove', 'checkoutStart', 'search', 'searchZero']
        && isEventSubject(doc)
        && doc.quantity is int && doc.quantity >= 1 && doc.quantity <= 20
        // 16 hex characters, generated by the browser for itself. Pinned to a
        // length and an alphabet so it cannot be used as a smuggling field.
        && doc.visitor is string
        && doc.visitor.size() == 16
        && doc.visitor.matches('^[0-9a-f]{16}$')
        && doc.day is string
        && doc.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        // The server's clock, not the browser's, so a client cannot backdate an
        // event into a period that has already been rolled up and signed off.
        && doc.at == request.time
        && doc.expiresAt is timestamp;
    }

    /*
     * A product event carries a slug and no term; a search carries a term and
     * no slug. Enforced as an exclusive choice rather than "at least one",
     * because a document with both would leave the rollup deciding which kind
     * of event it really was.
     */
    function isEventSubject(doc) {
      return (doc.kind in ['search', 'searchZero'])
        ? (doc.term is string && doc.term.size() > 0 && doc.term.size() <= 80 && doc.slug == null)
        : (doc.slug is string && doc.slug.size() > 0 && doc.slug.size() <= 120 && doc.term == null);
    }

    /*
     * The rolled-up numbers.
     *
     * Read by the shop and the treasurer only: these are the parish's sales
     * figures. Written solely by
     * the scheduled rollup through the Admin SDK, so `write: false` here costs
     * nothing and closes the obvious hole — a dashboard that could be edited by
     * the person it reports on is not a report.
     */
    match /bookstoreStats/{periodId} {
      /*
       * Two ways in, and the second is the one that carries its weight.
       *
       * `finance` is the only grant on this site that reaches a document
       * containing nothing but figures — no name, no address, no order behind
       * it, just what the shop took in a day. Which makes this the one place
       * the treasurer's flag can be honoured exactly: they get the takings and
       * they get nothing else. Everywhere else money is a field on a record
       * about a person, and rules grant documents rather than fields; see the
       * long note on `'finance'` in packages/shared/src/screens.ts.
       */
      allow read: if hasScreen('bookstore') || hasFinance('bookstore');
      allow write: if false;
    }

    /*
     * The rest of the parish's money, with the people taken out.
     *
     * ---------------------------------------------------------------------
     * This collection exists to close a hole in the rule directly above.
     *
     * `bookstoreStats` could be handed to the treasurer exactly, because it is
     * nothing but figures. The other two places the parish takes money could
     * not: a camp fee is `billing.payments[]` *inside* a `campRegistrations`
     * document, next to a child's allergies and medical notes, and a paid
     * form's total sits on the `formSubmissions` document beside every answer
     * given. Rules grant documents and not fields, so there was no way to write
     * a rule that gave `finance` the money without also giving it those. The
     * shortfall was documented in three places and left open on purpose.
     *
     * `functions/src/finance.ts` reads both collections with the Admin SDK,
     * which bypasses this file, and writes one document per camp season and per
     * paid form containing counts and sums and no name, no address, no email
     * and no check number. Those documents are these. The trust boundary moved
     * from a rule that could not be written to a Function that can be read.
     *
     * One door, unlike the takings above: this is not the shop's data and the
     * volunteer packing parcels has no use for it. `hasScreen('finance')` is
     * the superadmin or the person /access says this row is for.
     *
     * Unwritable by every client, like the takings. A report the reported-on
     * can edit is not a report.
     * ---------------------------------------------------------------------
     */
    match /financeRollups/{rollupId} {
      /*
       * One collection, two sources, and the `kind` field is what tells them
       * apart — `camp` for a season, `form` for a paid form.
       *
       * Read on the *document* rather than on the id, even though the id
       * carries the same prefix, and that is a Firestore constraint rather than
       * a preference. A `list` is evaluated against the query's potential
       * result set, so the only thing that can narrow one is a condition the
       * query itself can prove: `where('kind', '==', 'camp')` proves
       * `resource.data.kind == 'camp'` and nothing proves anything about the
       * document id. `features/finance/data.ts` therefore asks for the kinds it
       * holds, one query each, and never reads the bare collection.
       *
       * `resource != null` in front, for the reason recorded on the camp rules:
       * a `get()` of a document that is not there evaluates `resource.data` on
       * null, which is an error, and an error denies with a message that names
       * nothing. This denies too — but on purpose and for a reachable reason,
       * and a rollup that has not been computed yet is not something this
       * screen fetches by id.
       */
      allow read: if resource != null
        && ((resource.data.kind == 'camp' && hasFinance('camp'))
            || (resource.data.kind == 'form' && hasFinance('forms')));
      allow write: if false;
    }

    // ---- vehicle registration --------------------------------------------

    match /vehicles/{vehicleId} {
      // No public read: a plate-to-name mapping is exactly the kind of thing
      // that should not be enumerable. The `parking` grant only.
      allow read: if hasScreen('parking');
      allow read: if isSelf(resource.data.ownerUid);

      // Guests register without an account (§3.5), so this is open to
      // unauthenticated creates. That is intentional and bounded: create-only,
      // no read, field-validated, with abuse handling in a Function.
      allow create: if request.resource.data.plate is string
        && request.resource.data.plate.size() >= 2
        && request.resource.data.plate.size() <= 10
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.active == true
        && (
          (signedIn() && request.resource.data.ownerUid == request.auth.uid)
          || request.resource.data.ownerUid == null
        );

      allow update: if isSelf(resource.data.ownerUid) || hasScreen('parking');
      allow delete: if hasScreen('parking');
    }

    // ---- forms ------------------------------------------------------------

    match /forms/{formId} {
      /*
       * A form definition is public once published, and staff-only before.
       *
       * `isPublished` is doing real work here rather than hiding a draft for
       * tidiness: a form is built over several sittings in the drawer on
       * /forms, and a half-finished registration that anyone can find and fill
       * in produces submissions the parish then has to explain away.
       *
       * Note there is no `open` check. A *closed* form is still readable — the
       * page has to be able to say "registration closed on the 14th" rather
       * than 404, which is the difference between a form that has ended and a
       * link somebody mistyped. Whether a closed form can be *submitted* to is
       * decided in the Function, not here, because nothing writes submissions
       * from a client at all. See below.
       */
      allow read: if isPublished(resource.data);
      allow read: if hasScreen('forms');

      /*
       * Two forms cannot be deleted, by anybody, ever.
       *
       * `contact` and `vehicle-registration` are addressed from outside this
       * codebase: an NFC tag and a printed card in the car park point at one,
       * and every "ask the church office" link on the site — plus the parish's
       * own stationery — points at the other. Neither can be corrected by
       * editing a file, so a delete here is not an edit, it is a 404 discovered
       * by somebody standing in a car park on a Sunday.
       *
       * The drawer withholds the button and `deleteForm` throws before it gets
       * here. This is the one that holds: the other two are a page, and a page
       * is whatever the browser running it says it is.
       *
       * Deliberately NOT extended to unpublishing. A rule cannot usefully
       * distinguish "unticked Published by accident" from the several legitimate
       * writes that also carry that field, and the site now falls back to a
       * built-in copy of both forms when the document is missing or unreadable
       * — so the failure this closes is the irreversible one. See
       * `packages/shared/src/schema/builtInForms.ts`.
       *
       * The ids are transcribed from BUILT_IN_FORM_IDS in that file. A form
       * added there must be added here, and the reverse.
       */
      allow create, update: if hasScreen('forms');
      allow delete: if hasScreen('forms')
        && !(formId in ['contact', 'vehicle-registration']);
    }

    match /formSubmissions/{submissionId} {
      // Submitters can't re-read submissions; staff review them. Keeps one
      // person's registration from being readable by the next.
      //
      // The `forms` grant is deliberately one flag covering both collections
      // rather than two. Splitting "may build a form" from "may read its
      // replies" sounds tidier than it is: the builder needs to see a real
      // submission to know the form works, and a reviewer looking at an answer
      // they cannot explain needs the question. Neither job is doable with half
      // of this, so a grant that gave half would just be reported as broken.
      allow read: if hasScreen('forms');

      /*
       * STILL CLOSED — and now for a better reason than "no schema exists".
       *
       * The previous note here said: "`forms` and `formSubmissions` have
       * collection names and rules and no TypeScript type; when that type is
       * written, this rule gets written beside it and can validate against
       * something real."
       *
       * That type is now written — `packages/shared/src/schema/forms.ts`. The
       * conclusion it leads to is not the validating create rule that sentence
       * anticipated, so this is worth stating plainly rather than leaving the
       * next reader to wonder whether the work was forgotten.
       *
       * **Every submission goes through the `formSubmit` Function.** Three of
       * the things a submission has to do cannot be done from a browser at all:
       *
       *   1. Price it. A form charges a base fee plus per-option and per-unit
       *      prices, and the total must be computed from the *stored* definition
       *      by something the submitter cannot edit. A client write would mean
       *      the amount charged is a number the browser supplied.
       *   2. Take the payment. The Square access token lives in the Functions
       *      runtime and goes nowhere near a page.
       *   3. Reach Taksis. The vehicle form writes to a different Firebase
       *      project, which a browser holding our credentials cannot touch no
       *      matter what any rule says.
       *
       * Given the Function has to exist for those, routing the free forms
       * through it too costs one round trip and buys a single path — one place
       * that validates, one place that notifies, and no unauthenticated write
       * surface on a billed project. Rules cannot rate-limit; a Function can.
       *
       * The Admin SDK bypasses these rules, so `formSubmit` is unaffected by
       * this line. A create arriving here is by definition not from us.
       */
      allow create: if false;

      allow update, delete: if hasScreen('forms');
    }

    // ---- audit log --------------------------------------------------------

    match /auditLog/{entryId} {
      allow read: if isSuper();
      // Append-only, and only from the backend.
      allow write: if false;
    }

    // ---- notification devices ---------------------------------------------

    match /pushDevices/{deviceId} {
      /*
       * Closed to every client, in both directions. The endpoint is the door.
       *
       * -----------------------------------------------------------------------
       * This is the rule most likely to look wrong, because a person's own
       * notification preferences are exactly the kind of thing `match
       * /members/{uid}` lets them write for themselves. Three reasons it cannot
       * be that here, and the first is the one no rule can work around.
       *
       * **The document id is a SHA-256 of the FCM token.** It has to be derived
       * from the token rather than from the uid, because one servant has a
       * phone and an iPad and both should ring — and it has to be *hashed*
       * because an FCM token is base64 with characters a Firestore id may not
       * contain. Rules cannot hash. So a rule could not check that a caller's
       * chosen id matched the token in the body, and a client free to pick its
       * own id can overwrite **somebody else's registration** — pointing their
       * notifications at its own token. That is a read of other people's
       * notifications achieved entirely through a write, and it is why
       * POST /api/push/register is the only way in.
       *
       * **A subscription must be intersected with a grant, not merely checked
       * against one.** `pushRegister` reads the caller's member document and
       * ANDs their five requested notices against `entitledAdminNotices`,
       * saving the ones they hold and dropping the ones they do not. A rule can
       * refuse a request; it cannot partially honour one, so the equivalent
       * rule would 403 a stale app instead of saving the four rows it may have.
       *
       * **Read would expose who administers what.** A device row names a uid
       * beside the parts of the parish they are watching — a map of which
       * servant does which job, assembled from documents each of which only
       * ever needed to be written. `members/{uid}` is already `isSelf() ||
       * isSuper()` for the same reason, and this must not be the softer copy
       * of it.
       *
       * The fan-out reads and prunes this collection with the Admin SDK, which
       * bypasses these rules — the same arrangement as `mail` below and
       * `financeRollups` above. See functions/src/notify/.
       *
       * Note there is nothing here about *calendar reminders*. Those are local
       * notifications scheduled on the device and never leave it, so they have
       * no document in this collection and no rule anywhere. See
       * packages/shared/src/schema/notifications.ts for why that asymmetry is
       * deliberate rather than unfinished.
       * -----------------------------------------------------------------------
       */
      allow read: if false;
      allow write: if false;
    }

    // ---- outbound email ---------------------------------------------------

    match /mail/{messageId} {
      /*
       * Closed to clients in both directions, and both halves matter.
       *
       * Read would expose a buyer's address and what they bought to anyone who
       * guessed a document id. Write would turn the parish's mail server into
       * an open relay: the Trigger Email extension sends whatever it finds
       * here, so a client that could create a document could send mail from the
       * church's own domain to anyone.
       *
       * The catch-all below already denies this. It is written out because this
       * file's rule is that adding a collection means adding a rule on purpose,
       * and because a future edit to the catch-all should not quietly open a
       * send queue.
       */
      allow read, write: if false;
    }

    // ---- program galleries ------------------------------------------------
    // Standing programs, the tree of levels beneath each one, and the
    // photographs parishioners send in. See docs/program-galleries.md.
    //
    // `programEvents` is that tree: a program is the root, and every level under
    // it — a year, a week, a day, a part of a day — is one document in this
    // collection with a `parentId`. There is no separate collection or field for
    // "subgroup" any more, and no fixed depth.
    //
    // The second half of an allocation lives here. `superadmin` comes from the
    // token; program grants cannot, because they change often enough that
    // waiting an hour for a token to refresh would be a support call every
    // time. They are read from the member document instead — which is safe
    // because the member rule above pins `programAdmin` exactly as it pins
    // `screenAdmin`: a member cannot write their own grants.

    function memberGrants() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('programAdmin', {})
        : {};
    }

    // Ordered so the superadmin never pays for the member lookup, and so an
    // unauthenticated request short-circuits before touching `request.auth.uid`.
    function adminsProgram(programId) {
      return isSuper()
        || (signedIn() && programId in memberGrants().get('programs', []));
    }

    /*
     * Whether the caller runs the summer camp's back office.
     *
     * -------------------------------------------------------------------------
     * **This was `adminsProgram(<the camp's id>)` and is now a screen flag, and
     * the difference is a decision rather than a refactor.**
     *
     * A program grant is one permission with three consequences: it opens the
     * program document, every `programEvent` under it, and every photograph
     * sent in to those events. Using it for the camp's paperwork therefore made
     * "takes families at the registration desk" and "publishes the camp's event
     * pages and gallery" the same job, and /access carried a caveat saying so.
     * The two are now independent in both directions — `camp` in
     * `ADMIN_SCREENS` is this, and `programAdmin.programs` still governs the
     * camp's page, gatherings and pictures exactly as it governs every other
     * ministry's.
     *
     * ## What that changes about the rules below, beyond the name
     *
     * A program grant can only be proven *against a document* — hence the
     * `resource == null` branches on every `get` in this file and the rule that
     * a `list` must constrain `programId` or be refused outright (decision #10).
     * A screen flag is proven against the *caller*, so both of those go away
     * here: a `get` on a document that does not exist is fine because nothing is
     * read off it, and an unconstrained `getDocs` is now allowed. The camp
     * screens still send `where('programId','==',…)`, because a register from
     * another summer is not wanted rather than not permitted; nothing depends on
     * the constraint any more.
     *
     * `programId` is still pinned across every update below. It no longer
     * decides who may write — it decides which season's rollup a registration
     * lands in and which queries find it, and a document that can re-file
     * itself is a document that can go missing.
     *
     * ## Not the money, and be precise about why
     *
     * A registration carries `billing.payments[]`, so anybody who can read a
     * registration can read the ledger on it. This flag does not *hide* that
     * and could not: rules grant documents, not fields, which is the whole
     * reason `financeRollups` exists. What is separated is the screen —
     * /admin/camp shows balances and payment history only under
     * `hasFinance('camp')`. That half is a preference in a browser, and this
     * comment is where it says so rather than being mistaken for a boundary.
     * -------------------------------------------------------------------------
     */
    function runsCamp() {
      return hasScreen('camp');
    }

    function adminsProgramEvent(programId, programEventId) {
      return adminsProgram(programId)
        || (signedIn() && programEventId in memberGrants().get('events', []));
    }

    // `submissionTarget()` and `submissionProgram()` were here, reading the
    // level and the ministry an anonymous submission claimed. Both are gone
    // with the `galleryMedia` create rule that called them: no client creates
    // one now, so there is no untrusted `request.resource.data` to check.
    //
    // The same two reads still happen — in POST /api/gallery/upload-url, before
    // it issues a signed URL. What has changed is who pays for them. Here they
    // were on an unauthenticated write, so anybody could make the parish pay
    // for three document reads by posting nonsense; there they are behind a
    // verified App Check token.

    match /programs/{programId} {
      allow read: if isPublished(resource.data) || adminsProgram(programId);
      // Creating and retiring a program is the superadmin's alone. A program
      // administrator runs what they were given; they do not mint new ones.
      allow create, delete: if isSuper();
      // Name, description, cover, order — theirs to edit.
      allow update: if adminsProgram(programId);
    }

    match /programEvents/{programEventId} {
      allow read: if isPublished(resource.data)
        || adminsProgramEvent(resource.data.programId, programEventId);

      // Creating "Week 2 2027" is a statement about the program, so it takes a
      // program grant. `request.resource` rather than `resource`: on a create
      // there is no existing document to read the programId from.
      //
      // Nothing here checks `parentId`, and that is deliberate rather than
      // missing. This collection is a tree of arbitrary depth — every level is
      // one of these documents and `parentId` names the one above it — but the
      // *containment* that matters is `programId`, which is checked. A forged
      // `parentId` pointing into another ministry cannot smuggle a level into
      // that ministry's pages: every read filters `programId ==`, so a foreign
      // parent is simply absent from the tree that gets built and the level is
      // shown at the top of its own ministry (see `buildGalleryTree`). Checking
      // it properly would cost a `get()` on the parent for every write, to
      // prevent a mis-drawn page in one's own program.
      allow create: if adminsProgram(request.resource.data.programId);

      // Editing one — its description, where it sits, its layout, the pictures it
      // shows — is what an event-scoped volunteer was given the event for.
      //
      // Changing `programId` is a different act, and is checked differently.
      // Re-filing an event under another program is a statement about both
      // programs, so it takes a grant on both, at program level. Checking the
      // destination with `adminsProgramEvent` here would be no check at all:
      // the writer's grant on *this event* satisfies it whichever program the
      // event is moved into, which is precisely the escalation it was meant to
      // stop. tests/rules/program-galleries.test.ts caught that; the compile
      // check did not.
      allow update: if adminsProgramEvent(resource.data.programId, programEventId)
        && (request.resource.data.programId == resource.data.programId
            || (adminsProgram(resource.data.programId)
                && adminsProgram(request.resource.data.programId)));

      allow delete: if adminsProgram(resource.data.programId);
    }

    match /galleryMedia/{mediaId} {
      /*
       * Public reads are approved-only, and the client must say so in the
       * query.
       *
       * This is decision #10 again, in a collection where getting it wrong is
       * worse: a list query is evaluated against the documents it *could*
       * return, so `where('programEventId','==',x)` alone cannot prove that
       * nothing pending comes back, and Firestore denies the whole query. Every
       * public read therefore carries `where('status','==','approved')`, which
       * proves it. tests/rules covers exactly this — a compile check cannot.
       */
      allow read: if resource.data.status == 'approved'
        || adminsProgramEvent(resource.data.programId, resource.data.programEventId);

      /*
       * No client may create one. This is the chokepoint.
       *
       * -------------------------------------------------------------------
       * What used to be here was forty lines checking, field by field, that an
       * anonymous stranger's document said `pending`, carried no caption, chose
       * no placement, pointed at a `submissions/` path for its own event, and
       * belonged to a program still collecting. It worked. It is deleted anyway,
       * and not because it was wrong.
       *
       * It was only ever half of the write. The bytes went to Cloud Storage
       * first — deliberately, since a document with no file behind it is the
       * worse of the two failures — which meant every check in this block
       * guarded the *second* step of a two-step operation. A script that
       * uploaded a file and simply never wrote the document skipped all of it,
       * and the orphaned objects never appeared in the review queue, so nobody
       * would have noticed them sitting in a billed bucket.
       *
       * There is no rule that fixes that, because the two writes are to two
       * different services and only one of them was ever guarded. So both doors
       * are shut instead: `storage.rules` refuses every client write to
       * `submissions/`, this refuses every client create, and
       * POST /api/gallery/upload-url does both with the Admin SDK after
       * verifying an App Check token and counting the upload against a daily
       * quota that survives across Function instances.
       *
       * The field shape those forty lines enforced now lives in
       * `functions/src/galleries/uploadUrl.ts`, spelled out in full for exactly
       * that reason — it is the only thing holding it.
       *
       * A pleasant side effect: creating a submission cost up to three rule
       * reads here (`exists` and `get` on programEvents and programs) on an
       * *unauthenticated* write, which anyone could make the parish pay for by
       * posting nonsense. It now costs nothing, because it is refused
       * immediately.
       * -------------------------------------------------------------------
       */
      allow create: if false;

      // Approving, filing, captioning, laying out, rejecting. The one thing a
      // submitter cannot do to their own upload is anything at all — they have
      // no identity to match against, so there is nobody to grant it to.
      //
      // Filing is a write to `programEventId` now — moving a photograph to
      // another level of the tree — rather than to a `groupId` beside it. Note
      // what that means for an *event-scoped* grant: it is checked against the
      // level the photograph is on **before** the write, so a volunteer given one
      // week can move a photograph out of it and cannot move it back. That is
      // the right way round of the two: the alternative check, on the
      // destination, would let a grant on one day pull the whole ministry's
      // photographs into it. Program-scoped grants, which is what these
      // volunteers are normally given, are unaffected.
      allow update, delete: if adminsProgramEvent(resource.data.programId, resource.data.programEventId);
    }

    /* ======================================================================
       Gallery submission quota
       ====================================================================== */

    // How many photographs one uploader has sent today. Closed to everybody.
    //
    // Written only by POST /api/gallery/upload-url through the Admin SDK, which
    // bypasses this file entirely — so `if false` is the whole policy and not a
    // placeholder. Nothing in a browser has any business reading it: the
    // documents are keyed `uid:{uid}` and `ip:{sha256}`, and a readable
    // collection of address hashes with timestamps is a log of who visited
    // which gallery and when.
    //
    // It lives in Firestore rather than in the in-memory window in
    // `functions/src/rateLimit.ts` because that window is per Function
    // instance — its real allowance is the budget times maxInstances, which is
    // fine for a speed bump and useless as a daily total.
    match /submissionQuota/{key} {
      allow read, write: if false;
    }

    /* ======================================================================
       Summer camp registrations
       ====================================================================== */

    /*
     * The most sensitive collection in this file, and the one with the fewest
     * doors.
     *
     * A registration holds a child's date of birth, their allergies, their
     * medical notes and where they live. There is no public read, no anonymous
     * create, and no self-service path of any kind — every operation takes
     * `runsCamp()`, the `camp` screen flag, whose long note sits above
     * `adminsProgram` in this file.
     *
     * **It used to take the camp's program grant, and that was one grant doing
     * two jobs.** The same tick opened this collection and the camp's event
     * pages and gallery, so the registrar and the person posting the week's
     * photographs had to be the same person. They are now separate grants.
     *
     * Still specifically **not `finance`**, even though a registration carries a
     * fee ledger. Rules grant documents and not fields, so a flag that reached
     * the money here would also hand over a ten-year-old's allergies;
     * `financeRollups` exists so the treasurer can have the figures without the
     * children. See the long note on `'finance'` in
     * packages/shared/src/screens.ts, and the assertions in
     * tests/rules/access.test.ts that hold this line.
     *
     * The converse is worth stating too, because /admin/camp acts as though it
     * were not true: `camp` **can** read the ledger, because the ledger is a
     * field on a document this flag opens. The screen hides the balances and
     * the payment history from anybody without `hasFinance('camp')`, and that is
     * a preference in a browser rather than anything enforced here.
     *
     * Note what the flag costs, so nobody reports it as a bug: a `superadmin`
     * gets in via `hasScreen`, and everyone else needs `screenAdmin.camp` on
     * their member document — set by a superadmin at /access, and pinned against
     * self-writes by `match /members/{uid}` above.
     *
     * A list needs no `programId` constraint any more; the flag is proven
     * against the caller, not against a candidate document. The screens still
     * send one, because a different season's records are unwanted rather than
     * forbidden.
     */
    /*
     * Servants who have signed themselves up, waiting to be accepted.
     *
     * -----------------------------------------------------------------------
     * The only door into the camp that a stranger can knock on — and it does
     * not open onto the register.
     *
     * `campRegistrations` below is administrator-only in both directions, and
     * it has to stay that way: it holds children's allergies and medical notes.
     * A servant signing up is not that. It is one person saying which days they
     * can serve, and requiring the camp grant to type it in is how a camp ends
     * up with a spreadsheet nobody reconciles.
     *
     * So sign-ups land here instead, and this collection is written by exactly
     * one thing: `campServantRequest`, a Cloud Function, using the Admin SDK,
     * which these rules do not govern. The reasons a client create is refused
     * rather than validated are in that file — the ministry and the season are
     * read from `config/camp` rather than taken from the sender, and rules
     * cannot rate-limit an endpoint anybody on the internet can post to.
     *
     * Accepting one is the administrator's own browser writing a real
     * registration under their own uid and then deleting the request. Nothing
     * a stranger sends is ever read by the roster, the shirt count, or the
     * allocation board until somebody with the grant has said so.
     * -----------------------------------------------------------------------
     */
    match /campServantRequests/{requestId} {
      /*
       * `get` and `list` were split because a program grant had to be proven
       * against `resource.data.programId`, which a query cannot do without a
       * `where` on it. The flag is proven against the caller, so both are the
       * same condition now. They are left as two lines because the collection
       * gains a public read the day somebody decides a servant should see their
       * own pending sign-up, and that is a `get`.
       */
      allow get: if runsCamp();
      allow list: if runsCamp();

      // The Function only. See above.
      allow create, update: if false;

      // Dismissing a sign-up, and the second half of accepting one. Both are
      // the administrator's own delete of a document they can already read.
      allow delete: if runsCamp();
    }

    match /campRegistrations/{registrationId} {
      /*
       * One condition for both, and the bug that used to live here is worth
       * keeping in view.
       *
       * The save path reads a registration back before writing it, so a
       * replacing `setDoc` can carry `createdAt` across instead of destroying
       * it. Under the old program grant the *first* save read a document that
       * did not exist, `resource.data.programId` was an evaluation error, and
       * the error denied the read and took the whole save down with it — so the
       * `get` needed an explicit `resource == null ||` branch and the `list`
       * could not have one. A flag reads nothing off the document, so neither
       * problem exists and neither branch is needed. If this ever goes back to
       * being proven against a document, both come back with it.
       */
      allow get: if runsCamp();
      allow list: if runsCamp();

      // The bounds below are transcribed from packages/shared/src/schema/camp.ts.
      // A bound only present in TypeScript is not a bound — this file is what
      // somebody with a console has to get past. If one changes, both change.
      allow create: if runsCamp()
        && isCampRegistration(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      // The programId is still pinned across an update, for a reason that
      // changed with the grant. It is no longer who may write — it is which
      // season's finance rollup this family lands in and which queries find
      // them, and a record that can re-file itself is a record that can go
      // missing. There is no legitimate reason to move a registration between
      // ministries, so this stays a flat refusal.
      allow update: if runsCamp()
        && request.resource.data.programId == resource.data.programId
        && isCampRegistration(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      // Deleting is real deletion of a family's record. Withdrawing is a status
      // — `CAMP_STATUSES` has `withdrawn` precisely so that a family who pulled
      // out is still answerable for six months — so this is for a duplicate row
      // typed twice at a desk, and nothing else.
      allow delete: if runsCamp();
    }

    // The shape check, kept out of the rules above so they read as policy.
    //
    // Sizes rather than contents: rules cannot walk an array's members, so what
    // is enforced here is that nobody can grow a registration past the point
    // where the document stops being saveable, or write a fee big enough to make
    // a balance meaningless. Field-level validity — a real grade, a real shirt
    // size — is `parseCampRegistration`'s job on the way out, because a rule
    // that tried would be unmaintainable and would still not stop a determined
    // writer from putting nonsense in a string.
    function isCampRegistration(doc) {
      return doc.season is string
        && doc.season.size() > 0
        && doc.season.size() <= 120
        && doc.kind in ['family', 'servant']
        && doc.status in ['draft', 'registered', 'waitlisted', 'withdrawn']
        && doc.children is list
        && doc.children.size() <= 20
        && doc.billing.baseCents is int
        && doc.billing.baseCents >= 0
        && doc.billing.baseCents <= 500000
        && doc.billing.discounts is list
        && doc.billing.discounts.size() <= 12
        && doc.billing.payments is list
        && doc.billing.payments.size() <= 24;
    }

    /* ======================================================================
       Summer camp allocation
       ====================================================================== */

    /*
     * How a season is divided up: grade bands, their groups, the stations, and
     * which child or servant is in each.
     *
     * The same door as the registrations above — `runsCamp()`, the `camp`
     * screen flag — and for the same reason rather than by copying. This document
     * holds no names, no dates of birth and no medical notes: a group is a list
     * of keys of the form `registrationId/childId`, and every name on the screen
     * is looked up from `campRegistrations`. So the *contents* here are close to
     * meaningless on their own. What makes the grant the right door anyway is
     * that the document is only useful to somebody who can already read the
     * registrations, and a second, wider door onto the same work is a door
     * somebody has to remember exists.
     *
     * ## No list rule, deliberately
     *
     * There is exactly one allocation per season and its id is derived —
     * `<programId>__<season>`, see `allocationDocId` — so the screen reads it
     * with a `get` and never queries the collection. Adding `allow list` would
     * mean thinking about the decision #10 trap again for a query nothing
     * makes. If a "past seasons" screen ever needs one, it takes a
     * `where('programId','==',…)` constraint exactly as the registrations do,
     * and this comment is the warning that it is not free.
     */
    match /campAllocations/{allocationId} {
      /*
       * No `resource == null` branch, and there used to be one.
       *
       * The screen opens on a season nobody has allocated yet, and the save
       * path reads the document back before writing so a replacing `setDoc`
       * carries `createdAt` across. Under a program grant both were reads of a
       * document that did not exist, `resource.data.programId` was an
       * evaluation error, and the error denied the read and blanked the screen
       * on its first paint. A flag reads nothing off the document, so the
       * branch is gone rather than merely unnecessary.
       */
      allow get: if runsCamp();

      /*
       * Listing the seasons, for the year list on the camp's front door.
       *
       * This needed `where('programId','==',…)` on every caller, because a rule
       * reading `resource.data.programId` refuses any query that *could* return
       * another ministry's document rather than filtering it — the galleryMedia
       * trap, where the failure looks like a permission bug and is a missing
       * `where`. The flag is proven against the caller, so an unconstrained
       * query is allowed now. The screens still constrain it, for their own
       * reasons.
       */
      allow list: if runsCamp();

      allow create: if runsCamp()
        && isCampAllocation(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      // The programId is pinned across an update, exactly as it is on a
      // registration, and now for the same narrower reason: the id of this
      // document encodes it, so a write that changed it would leave
      // `summercamp__2027` claiming to belong to another ministry.
      allow update: if runsCamp()
        && request.resource.data.programId == resource.data.programId
        && isCampAllocation(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      // Deleting an allocation destroys an evening's work and nothing else —
      // no registration is touched, and re-creating it is starting over. It is
      // allowed because a season allocated by mistake has to be removable, and
      // the screen asks first.
      allow delete: if runsCamp();
    }

    /*
     * The shape check for an allocation.
     *
     * Note what this can and cannot see. Rules cannot walk into an array's
     * members, so the number of *groups inside* a band and the number of people
     * inside a group are invisible here — `MAX_GROUPS_PER_BAND`,
     * `MAX_PLACEMENTS_PER_GROUP` and `MAX_PLACEMENTS` are enforced only by
     * `parseCampAllocation` and the placement functions in
     * packages/shared/src/schema/campAllocation.ts. That is a real gap and this
     * comment exists so nobody reads the bounds in TypeScript and assumes they
     * hold against a console.
     *
     * What is left is the flat shape: a season, and lists of a sane length at
     * the top level. It is what stops a write that would make the screen
     * unopenable, not a proof that the contents are sensible. Firestore's own
     * 1MiB document limit is the backstop for the case rules cannot reach.
     */
    function isCampAllocation(doc) {
      return doc.season is string
        && doc.season.size() > 0
        && doc.season.size() <= 120
        /*
         * One board per week: `weeks` is a list, and everything draggable is
         * inside it. Nine is `MAX_CAMP_WEEKS`; the bands and stations within a
         * week, the groups within a band and the people within a group all stay
         * out of reach here, as they always have.
         *
         * A document written while the camp had one flat arrangement has
         * `bands` and `stations` at the top and no `weeks`. It is still
         * *readable* — the parser lifts it into week one — but it cannot be
         * written back in that shape, and that is the right way round: every
         * write comes from the screen, and the screen has already converted it.
         */
        && doc.weeks is list
        && doc.weeks.size() <= 9;
    }

    /* ======================================================================
       Summer camp attendance
       ====================================================================== */

    /*
     * The register: one document per day of camp, one entry per child.
     *
     * The same door again — `runsCamp()` — and this time the contents
     * genuinely warrant it rather than merely matching. An
     * allocation is a list of opaque keys; a register is a statement about
     * which named children were on a site this morning and which of them are
     * still there at four o'clock. It is read from a phone at a gate, and the
     * flag is the only thing between that phone and the answer.
     *
     * ## Merge writes, and what rules see of them
     *
     * Every tick is `setDoc(…, { merge: true })` touching one field path inside
     * `entries`. `request.resource.data` is the document *after* the merge, so
     * the shape check below runs against the whole register even though the
     * client sent one child. That is the right way round: a tap cannot leave
     * the day in a shape the screen cannot open, whatever else is already in
     * it.
     *
     * What rules cannot see is inside the map. `entries` is
     * `{ "<registrationId>/<childId>": { arrived: {...}, collected: {...} } }`
     * and a rule cannot walk into a map's values any more than it can walk into
     * a list's members — so the marks themselves, their timestamps and their
     * `by` uids are checked by `parseCampAttendanceDay` and nothing else. The
     * bound that *is* enforceable is the count, and it is.
     */
    match /campAttendance/{dayId} {
      /*
       * No `resource == null` branch, for the third time and the same reason as
       * the two above: a day nobody has ticked yet is the normal first state of
       * this screen, and `runsCamp()` reads nothing off the document that is
       * not there.
       */
      allow get: if runsCamp();

      /*
       * Listing a season's registers — for a summary across the fortnight.
       *
       * Nothing queries this yet, and it costs nothing to allow: the flag is
       * the same whatever the query asks for. Were this ever proven against the
       * document again, the trap is the one stated above — a rule reading
       * `resource.data.programId` refuses an unconstrained query rather than
       * filtering it.
       */
      allow list: if runsCamp();

      allow create: if runsCamp()
        && isCampAttendance(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      /*
       * `programId` and `day` are both pinned across an update.
       *
       * The programId for the reason it is pinned everywhere else — re-filing a
       * document under a ministry you administer is how you pull one out of a
       * ministry you do not. The `day` because the id encodes it: a write that
       * changed it would leave `campAttendance/…__w1-tue` claiming to be
       * Wednesday, and every reader here derives the id from the day it wants.
       */
      allow update: if runsCamp()
        && request.resource.data.programId == resource.data.programId
        && request.resource.data.day == resource.data.day
        && isCampAttendance(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      /*
       * No delete, and this is the one camp collection that has none.
       *
       * An allocation deleted by mistake costs an evening. A register is the
       * record of which children were in somebody's care on a given day, and
       * the moment it is worth anything is the moment somebody wishes it were
       * gone. A day ticked in error is fixed by untucking the ticks — the
       * screen writes nulls — which leaves the correction visible in
       * `updatedBy` and `updatedAt` instead of leaving nothing at all.
       */
    }

    function isCampAttendance(doc) {
      return doc.season is string
        && doc.season.size() > 0
        && doc.season.size() <= 120
        // `w1-mon`. Short because it is generated, never typed.
        && doc.day is string
        && doc.day.size() > 0
        && doc.day.size() <= 16
        // 800 is MAX_ATTENDANCE_ENTRIES in
        // packages/shared/src/schema/campAttendance.ts. The only bound rules
        // can reach: the marks inside each entry are invisible from here.
        && doc.entries is map
        && doc.entries.size() <= 800;
    }

    // Anything not matched above is denied. Adding a collection means adding a
    // rule here on purpose, rather than inheriting an accidental allow.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
