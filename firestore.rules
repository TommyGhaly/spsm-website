rules_version = '2';

// Authorization lives here, not in the UI. Anything the client hides is a
// convenience; anything this file allows is the actual policy.
//
// Two axes, matching packages/shared/src/roles.ts:
//   role   — linear tier: member < servant < staff < admin
//   groups — cross-cutting: clergy, prayerTeam, bookstore, parking
//
// Both come from Auth custom claims (the ID token), never from a Firestore
// document. Reading them from /members would let a member promote themselves by
// editing their own profile.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- claim helpers -----------------------------------------------------

    function claims() {
      return request.auth != null ? request.auth.token : {};
    }

    function roleRank() {
      let r = claims().get('role', 'member');
      return r == 'admin' ? 3 : r == 'staff' ? 2 : r == 'servant' ? 1 : 0;
    }

    function rankOf(role) {
      return role == 'admin' ? 3 : role == 'staff' ? 2 : role == 'servant' ? 1 : 0;
    }

    function hasRole(role) {
      return request.auth != null && roleRank() >= rankOf(role);
    }

    function inGroup(group) {
      return request.auth != null && group in claims().get('groups', []);
    }

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Cloud Functions use the Admin SDK, which bypasses these rules entirely.
    // So "no client may write X" below still leaves X writable by our backend.

    // ---- helpers for content ----------------------------------------------

    // `published` is the whole switch. `publishAt` is deliberately NOT read
    // here, and that is load-bearing rather than an omission.
    //
    // This rule used to be:
    //   doc.published == true && (doc.publishAt == null || doc.publishAt <= request.time)
    //
    // It compiled, and `npm run rules:check` passed, and it denied every public
    // list query in existence. Firestore evaluates a `list` against the query's
    // *potential* result set, not the documents actually returned — so it has
    // to prove from the query constraints alone that no disallowed document
    // could come back. `where('published','==',true)` proves the first clause
    // and says nothing about the second, so the whole query is rejected.
    //
    // Measured against the live project, empty collection:
    //   where('published','==',true)                          -> permission-denied
    //   where('published','==',true), where('publishAt','==',null) -> allowed
    //
    // That second line is the trap. It is the only query the old rule admitted,
    // and it silently excludes every document that has a publishAt — including
    // after that time has passed. Scheduled content would never appear, and
    // nothing would error.
    //
    // So scheduling moved to where it can actually work: `publishAt` is an
    // instruction to a scheduled Cloud Function, which flips `published` to
    // true when the time arrives. That is required anyway — the public site is
    // a static export, so a page going live means a rebuild, and no read-time
    // rule can trigger one. See docs/decisions.md #10.
    function isPublished(doc) {
      return doc.published == true;
    }

    // ---- public content ---------------------------------------------------
    // Readable by the world (the static export reads these at build time and
    // the PWA caches them offline). Writable only by staff.

    match /content/{pageId} {
      allow read: if isPublished(resource.data) || hasRole('staff');
      allow write: if hasRole('staff');
    }

    match /announcements/{announcementId} {
      allow read: if isPublished(resource.data) || hasRole('staff');
      allow write: if hasRole('staff');
    }

    // ---- runtime configuration --------------------------------------------
    // Integration endpoints and feature switches that staff change without a
    // deploy. See packages/shared/src/schema/config.ts.
    //
    // World-readable, deliberately: the website build reads this as an
    // anonymous client before it has any other credential, so there is no
    // identity to gate on. That is only acceptable because of what lives here —
    // a project id and a collection name authorize nothing, and access to the
    // other project is controlled by its IAM, not by the obscurity of its name.
    //
    // ANYTHING WRITTEN HERE IS PUBLIC. No service-account keys, no API tokens,
    // no webhook signing secrets. Those belong in Secret Manager.
    match /config/{docId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    /*
     * The shop's divisions, writable by the people who run the shop.
     *
     * -----------------------------------------------------------------------
     * A second match on a path the rule above already covers. Firestore grants
     * if **any** matching rule allows, so this can only widen `config/{docId}` —
     * it cannot narrow it, and nothing here tries to.
     *
     * A near-identical block existed briefly to support an in-place settings
     * editor, and was removed with that editor because an open write path kept
     * for a caller that no longer exists is pure attack surface. It is back for
     * a caller that does exist: the section editor in the admin drawer. The
     * difference is the key set — `sections` only. The delivery charge, the
     * order email and the two pieces of shop copy are **not** writable here and
     * remain admin-only through the rule above, because nothing in a browser
     * writes them.
     *
     * `config` is world-readable, so a writer cannot leak anything they could
     * not already read; the risk is a malformed document breaking the shop, and
     * the shape check below is what bounds that. Twelve sections, forty
     * characters of label. `parseSections` drops anything that gets through.
     * -----------------------------------------------------------------------
     */
    match /config/bookstore {
      allow read: if true;

      /*
       * Create and update are separate, and that is not tidiness.
       *
       * `request.resource.data.diff(resource.data)` needs `resource` to exist.
       * Nothing seeds `config/bookstore` — the defaults live in the shared
       * package and the document is written the first time somebody changes
       * something — so on a parish that has never touched it, `resource` is
       * null, `diff` fails, and the *first* section anyone tries to make is
       * refused with nothing to explain it. The create branch checks the whole
       * key set instead, which is the same guarantee without the dereference.
       */
      allow create: if (inGroup('bookstore') || hasRole('staff'))
        && request.resource.data.keys().hasOnly(['sections', 'updatedAt', 'updatedBy'])
        && isSectionList(request.resource.data.sections)
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if (inGroup('bookstore') || hasRole('staff'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['sections', 'updatedAt', 'updatedBy'])
        && isSectionList(request.resource.data.sections)
        && request.resource.data.updatedBy == request.auth.uid;

      // Never. The shop's divisions going missing wholesale is not an edit.
      allow delete: if false;
    }

    function isSectionList(sections) {
      return sections is list && sections.size() <= 12;
    }

    match /events/{eventId} {
      // Parish calendar. Servant-only entries live in /servantEvents so this
      // stays a path check rather than a per-doc audience filter — a filter
      // would leak titles through list queries if anyone forgot a where().
      //
      // ---------------------------------------------------------------------
      // WORLD-READABLE, and that is a deliberate change rather than a slip.
      //
      // This was `isPublished(resource.data) || hasRole('staff')`, which kept
      // unpublished events staff-only. The `published` field is gone: at Tommy's
      // direction the events editor has no publish step at all — typing saves,
      // and an event exists or it does not. There is no longer any such thing as
      // an event that is in the collection but not on the website, so there is
      // nothing for a read rule to distinguish.
      //
      // Two things follow, and both are consequences of that decision rather
      // than of this line:
      //
      //  - **The rule had to change or the site would go blank.** `data.ts` reads
      //    this collection *anonymously* at build time. With `published` absent,
      //    `isPublished(resource.data)` is false for every document, so the old
      //    rule would have denied the build's read and every event would have
      //    disappeared from the site at the next deploy.
      //  - **Anything left in the collection is public.** An event nobody wants
      //    seen has to be deleted, not hidden. That is the model now.
      //
      // Servant-only entries are unaffected: they are in /servantEvents below,
      // which is a different path with a different rule, and always were.
      // ---------------------------------------------------------------------
      allow read: if true;
      allow write: if hasRole('staff');
    }

    match /servantEvents/{eventId} {
      allow read: if hasRole('servant');
      allow write: if hasRole('staff');
    }

    // The Breeze calendar embed URL, and nothing else.
    //
    // Not a document under /config, and that is the whole point. `config` is
    // `allow read: if true`, and a narrower rule cannot take that back —
    // Firestore grants when ANY matching rule allows, so `config/servants`
    // would be world-readable no matter what was written here. A separate
    // collection is the only way to gate it.
    //
    // It has to be gated because the embed URL is itself the credential: Breeze
    // serves the calendar to anyone who requests that URL, with no session and
    // no referrer check. The website is a static export, so the alternative —
    // baking it into /servants — publishes it on a CDN behind a sign-in form
    // that stops nobody.
    match /servantsConfig/{docId} {
      allow read: if hasRole('servant');
      allow write: if hasRole('admin');
    }

    // ---- members ----------------------------------------------------------

    match /members/{uid} {
      allow read: if isSelf(uid) || hasRole('staff');

      // A member may edit their own profile but may NOT touch the claim
      // mirrors — those are set by a Function after claims change — nor
      // `screenAdmin`, which is a permission and not a preference.
      //
      // `screenAdmin` matters more than the mirrors it sits beside. The mirrors
      // are cosmetic: rules read the token, so a forged `roleMirror` grants
      // nothing. `screenAdmin` has no claim behind it — it is the only record
      // of which areas a non-admin may manage — so a member who could write it
      // could open every admin screen on the site to themselves. Hence it is
      // pinned on create as well as update.
      allow create: if isSelf(uid)
        && request.resource.data.roleMirror == 'member'
        && request.resource.data.groupsMirror.size() == 0
        && (!('screenAdmin' in request.resource.data)
            || !request.resource.data.screenAdmin.values().hasAny([true]))
        // `programAdmin` is the same kind of thing as `screenAdmin` and is
        // pinned for the same reason — but it is read by the gallery rules
        // below via `get()`, which makes it the one permission on this site
        // that a self-written member document could actually exercise. A
        // member who could seed it on create would own every program.
        && (!('programAdmin' in request.resource.data)
            || (request.resource.data.programAdmin.get('programs', []).size() == 0
                && request.resource.data.programAdmin.get('events', []).size() == 0));

      allow update: if isSelf(uid)
        && request.resource.data.roleMirror == resource.data.roleMirror
        && request.resource.data.groupsMirror == resource.data.groupsMirror
        // Byte-for-byte identical, rather than "no true values". A member must
        // not be able to revoke their own grants either — a support call about
        // access that silently disappeared is worse than one about access that
        // was never given.
        && request.resource.data.get('screenAdmin', {}) == resource.data.get('screenAdmin', {})
        && request.resource.data.get('programAdmin', {}) == resource.data.get('programAdmin', {});

      allow update: if hasRole('admin');
      allow delete: if hasRole('admin');
    }

    // ---- prayer requests --------------------------------------------------
    // Privacy model: Firestore at-rest encryption (Decision #1, Option A).
    // Bodies are plaintext and readable by clergy. Enforcement is here.

    match /prayerRequests/{requestId} {

      // Public requests: any signed-in member, plus the prayer team.
      // Clergy-only requests: clergy group or admin. Staff tier alone is NOT
      // enough — a facilities coordinator has no business reading these.
      allow read: if (resource.data.visibility == 'public' && signedIn())
        || inGroup('clergy')
        || hasRole('admin');

      // Open to unauthenticated writers, and it has to be.
      //
      // This required `signedIn()` when sign-in was expected to be for
      // everyone. It is not: authentication is Microsoft-only against the
      // parish Entra tenant, so clergy, staff and servants have accounts and a
      // parishioner deliberately does not. Keeping the requirement would mean
      // the only people who could ask for prayer are the people you would ask
      // in person anyway.
      //
      // So this is bounded the way `vehicles` is — create-only, no read, every
      // field checked, and abuse handled in a Function rather than here.
      allow create: if request.resource.data.keys().hasOnly([
          'body', 'visibility', 'anonymous', 'authorUid', 'authorName',
          'contactEmail', 'status', 'notifiedAt',
          'createdAt', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.visibility in ['public', 'clergy']
        && request.resource.data.status == 'active'
        && request.resource.data.notifiedAt == null
        && (request.resource.data.contactEmail == null
          || (request.resource.data.contactEmail is string
            && request.resource.data.contactEmail.size() <= 254))
        // A uid may only ever be your own. An unauthenticated writer must leave
        // it null rather than claiming to be a member.
        && request.resource.data.authorUid == (signedIn() ? request.auth.uid : null)
        && (
          // Anonymity is real, not cosmetic: no uid *and* no name, so there is
          // nothing to trace back later — including by us.
          (request.resource.data.anonymous == true
            && request.resource.data.authorUid == null
            && request.resource.data.authorName == null)
          ||
          // Otherwise they told us what to call them. Unverified when they are
          // not signed in, which is fine: it is a name for the fathers to pray
          // with, not an identity claim that authorizes anything.
          (request.resource.data.anonymous == false
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() > 0
            && request.resource.data.authorName.size() <= 100)
        );

      // The trade-off of true anonymity: with no uid stored, there is nobody to
      // authorize an edit. Anonymous requests are clergy-managed only.
      allow update: if (resource.data.authorUid != null && isSelf(resource.data.authorUid))
        || inGroup('clergy')
        || hasRole('admin');

      allow delete: if inGroup('clergy') || hasRole('admin');
    }

    // ---- bookstore --------------------------------------------------------

    match /products/{productId} {
      allow read: if isPublished(resource.data);
      allow read: if hasRole('staff');
      // Catalog writes go through the Square sync Function or staff tooling.
      allow write: if hasRole('staff');

      /*
       * The one field the bookstore group may change: which part of the shop a
       * product appears in.
       *
       * A widening of the rule above, which is `staff` only. A bookstore
       * volunteer is `member` plus the group — the same people who work the
       * orders queue — and filing a book under "Icons" is the least consequential
       * thing on that screen. Everything Square owns stays untouchable from a
       * browser: `hasOnly` admits three keys and `section` is the only one that
       * carries meaning.
       *
       * Creating a product is *not* here and must not be. It has to happen in
       * Square first, because the checkout prices orders from Square's catalog —
       * a row invented in Firestore has no variation id and cannot be bought.
       * That path is `squareCreateProduct`, which re-checks the claim server-side.
       */
      allow update: if (inGroup('bookstore') || hasRole('staff'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['section', 'updatedAt', 'updatedBy'])
        && (request.resource.data.section == null
            || (request.resource.data.section is string
                && request.resource.data.section.size() <= 40))
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /orders/{orderId} {
      // A member sees their own orders; bookstore volunteers see all.
      //
      // A buyer is neither. Sign-in here is Microsoft-only and restricted to
      // the parish tenant, so a parishioner has no uid for `isSelf` to match —
      // they reach their orders through the `orderLookup` Function, which
      // authenticates them with a receipt instead. Nothing below grants them
      // anything, and that is correct: the Admin SDK bypasses these rules.
      allow read: if isSelf(resource.data.memberUid)
        || inGroup('bookstore')
        || hasRole('staff');

      // Orders are created and advanced ONLY by Cloud Functions reconciling
      // Square webhooks. If the client could write here, a member could mark
      // their own order paid.
      allow create, delete: if false;

      /*
       * The one exception: whether the books have been handed over.
       *
       * `fulfillment` is the only field a volunteer changes, and it is the only
       * field this admits. Everything about money — `status`, `total`,
       * `refund`, `squarePaymentId` — stays unwritable by any client, because
       * the reason the rest of this block says `false` is that a client able to
       * write `status` is a client able to mark its own order paid. Packing a
       * parcel is not that, and routing it through a Cloud Function would buy
       * nothing but a cold start.
       *
       * `hasOnly` is what makes the sentence above true. Without it a write
       * that sets `fulfillment` may set anything else in the same breath.
       */
      allow update: if (inGroup('bookstore') || hasRole('staff'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fulfillment', 'updatedAt', 'updatedBy'])
        && request.resource.data.fulfillment in ['unfulfilled', 'ready', 'collected']
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // ---- bookstore statistics ---------------------------------------------

    /*
     * One document per view, cart change, and search.
     *
     * -----------------------------------------------------------------------
     * Writable by anyone, readable by nobody, and both halves are load-bearing.
     *
     * Writable because the people being counted are not signed in and never
     * will be: this site has no public authentication at all. There is no
     * identity to gate on, so the gate is the shape of the document instead —
     * every field below is bounded and typed, which is what keeps an open
     * `create` from being an open-ended write.
     *
     * Readable by nobody, which is what makes the open create acceptable. There
     * is no `list` here and no `get`, so the collection cannot be enumerated,
     * cannot be mined, and holds nothing that identifies anyone in the first
     * place — `visitor` is a random string the browser made up about itself.
     * The worst an abuser achieves is a wrong number on a parish dashboard.
     *
     * No update and no delete: an event is a fact about a moment, and a fact
     * that can be edited afterwards is not one. Old rows leave via the TTL
     * policy on `expiresAt`, which is the database's job rather than a client's.
     *
     * This block and packages/shared/src/analytics/bookstoreEvents.ts must
     * agree field for field. A document this rule rejects is invisible — the
     * write fails inside a fire-and-forget batch that swallows errors, and the
     * statistic just stops moving with nothing in any log to say why.
     * -----------------------------------------------------------------------
     */
    match /bookstoreEvents/{eventId} {
      allow read, update, delete: if false;

      allow create: if isBookstoreEvent(request.resource.data);
    }

    function isBookstoreEvent(doc) {
      return doc.keys().hasOnly(['kind', 'slug', 'term', 'quantity', 'visitor', 'day', 'at', 'expiresAt'])
        && doc.keys().hasAll(['kind', 'slug', 'term', 'quantity', 'visitor', 'day', 'at', 'expiresAt'])
        && doc.kind in ['view', 'detail', 'cartAdd', 'cartRemove', 'checkoutStart', 'search', 'searchZero']
        && isEventSubject(doc)
        && doc.quantity is int && doc.quantity >= 1 && doc.quantity <= 20
        // 16 hex characters, generated by the browser for itself. Pinned to a
        // length and an alphabet so it cannot be used as a smuggling field.
        && doc.visitor is string
        && doc.visitor.size() == 16
        && doc.visitor.matches('^[0-9a-f]{16}$')
        && doc.day is string
        && doc.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        // The server's clock, not the browser's, so a client cannot backdate an
        // event into a period that has already been rolled up and signed off.
        && doc.at == request.time
        && doc.expiresAt is timestamp;
    }

    /*
     * A product event carries a slug and no term; a search carries a term and
     * no slug. Enforced as an exclusive choice rather than "at least one",
     * because a document with both would leave the rollup deciding which kind
     * of event it really was.
     */
    function isEventSubject(doc) {
      return (doc.kind in ['search', 'searchZero'])
        ? (doc.term is string && doc.term.size() > 0 && doc.term.size() <= 80 && doc.slug == null)
        : (doc.slug is string && doc.slug.size() > 0 && doc.slug.size() <= 120 && doc.term == null);
    }

    /*
     * The rolled-up numbers.
     *
     * Staff-only read: these are the parish's sales figures. Written solely by
     * the scheduled rollup through the Admin SDK, so `write: false` here costs
     * nothing and closes the obvious hole — a dashboard that could be edited by
     * the person it reports on is not a report.
     */
    match /bookstoreStats/{periodId} {
      allow read: if inGroup('bookstore') || hasRole('staff');
      allow write: if false;
    }

    // ---- vehicle registration --------------------------------------------

    match /vehicles/{vehicleId} {
      // No public read: a plate-to-name mapping is exactly the kind of thing
      // that should not be enumerable. Staff/parking only.
      allow read: if inGroup('parking') || hasRole('staff');
      allow read: if isSelf(resource.data.ownerUid);

      // Guests register without an account (§3.5), so this is open to
      // unauthenticated creates. That is intentional and bounded: create-only,
      // no read, field-validated, with abuse handling in a Function.
      allow create: if request.resource.data.plate is string
        && request.resource.data.plate.size() >= 2
        && request.resource.data.plate.size() <= 10
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.active == true
        && (
          (signedIn() && request.resource.data.ownerUid == request.auth.uid)
          || request.resource.data.ownerUid == null
        );

      allow update: if isSelf(resource.data.ownerUid) || hasRole('staff');
      allow delete: if hasRole('staff');
    }

    // ---- forms ------------------------------------------------------------

    match /forms/{formId} {
      /*
       * A form definition is public once published, and staff-only before.
       *
       * `isPublished` is doing real work here rather than hiding a draft for
       * tidiness: a form is built over several sittings in the drawer on
       * /forms, and a half-finished registration that anyone can find and fill
       * in produces submissions the parish then has to explain away.
       *
       * Note there is no `open` check. A *closed* form is still readable — the
       * page has to be able to say "registration closed on the 14th" rather
       * than 404, which is the difference between a form that has ended and a
       * link somebody mistyped. Whether a closed form can be *submitted* to is
       * decided in the Function, not here, because nothing writes submissions
       * from a client at all. See below.
       */
      allow read: if isPublished(resource.data);
      allow read: if hasRole('staff');
      allow write: if hasRole('staff');
    }

    match /formSubmissions/{submissionId} {
      // Submitters can't re-read submissions; staff review them. Keeps one
      // person's registration from being readable by the next.
      allow read: if hasRole('staff');

      /*
       * STILL CLOSED — and now for a better reason than "no schema exists".
       *
       * The previous note here said: "`forms` and `formSubmissions` have
       * collection names and rules and no TypeScript type; when that type is
       * written, this rule gets written beside it and can validate against
       * something real."
       *
       * That type is now written — `packages/shared/src/schema/forms.ts`. The
       * conclusion it leads to is not the validating create rule that sentence
       * anticipated, so this is worth stating plainly rather than leaving the
       * next reader to wonder whether the work was forgotten.
       *
       * **Every submission goes through the `formSubmit` Function.** Three of
       * the things a submission has to do cannot be done from a browser at all:
       *
       *   1. Price it. A form charges a base fee plus per-option and per-unit
       *      prices, and the total must be computed from the *stored* definition
       *      by something the submitter cannot edit. A client write would mean
       *      the amount charged is a number the browser supplied.
       *   2. Take the payment. The Square access token lives in the Functions
       *      runtime and goes nowhere near a page.
       *   3. Reach Taksis. The vehicle form writes to a different Firebase
       *      project, which a browser holding our credentials cannot touch no
       *      matter what any rule says.
       *
       * Given the Function has to exist for those, routing the free forms
       * through it too costs one round trip and buys a single path — one place
       * that validates, one place that notifies, and no unauthenticated write
       * surface on a billed project. Rules cannot rate-limit; a Function can.
       *
       * The Admin SDK bypasses these rules, so `formSubmit` is unaffected by
       * this line. A create arriving here is by definition not from us.
       */
      allow create: if false;

      allow update, delete: if hasRole('staff');
    }

    // ---- audit log --------------------------------------------------------

    match /auditLog/{entryId} {
      allow read: if hasRole('admin');
      // Append-only, and only from the backend.
      allow write: if false;
    }

    // ---- outbound email ---------------------------------------------------

    match /mail/{messageId} {
      /*
       * Closed to clients in both directions, and both halves matter.
       *
       * Read would expose a buyer's address and what they bought to anyone who
       * guessed a document id. Write would turn the parish's mail server into
       * an open relay: the Trigger Email extension sends whatever it finds
       * here, so a client that could create a document could send mail from the
       * church's own domain to anyone.
       *
       * The catch-all below already denies this. It is written out because this
       * file's rule is that adding a collection means adding a rule on purpose,
       * and because a future edit to the catch-all should not quietly open a
       * send queue.
       */
      allow read, write: if false;
    }

    // ---- program galleries ------------------------------------------------
    // Standing programs, the tree of levels beneath each one, and the
    // photographs parishioners send in. See docs/program-galleries.md.
    //
    // `programEvents` is that tree: a program is the root, and every level under
    // it — a year, a week, a day, a part of a day — is one document in this
    // collection with a `parentId`. There is no separate collection or field for
    // "subgroup" any more, and no fixed depth.
    //
    // The third permission axis lives here. `role` and `groups` come from the
    // token; program grants cannot, because they change often enough that
    // waiting an hour for a token to refresh would be a support call every
    // time. They are read from the member document instead — which is safe in
    // a way `role` would not be, because the member rule above pins
    // `programAdmin` exactly as it pins `screenAdmin`: a member cannot write
    // their own grants.

    function memberGrants() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid))
        ? get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('programAdmin', {})
        : {};
    }

    // Ordered so an admin never pays for the member lookup, and so an
    // unauthenticated request short-circuits before touching `request.auth.uid`.
    function adminsProgram(programId) {
      return hasRole('admin')
        || (signedIn() && programId in memberGrants().get('programs', []));
    }

    function adminsProgramEvent(programId, programEventId) {
      return adminsProgram(programId)
        || (signedIn() && programEventId in memberGrants().get('events', []));
    }

    // The event an anonymous submission says it belongs to. Guarded by an
    // `exists()` at the call site — `get()` on a missing document fails the
    // whole evaluation, which denies, but denies for the wrong reason and is
    // miserable to debug.
    function submissionTarget() {
      return get(/databases/$(database)/documents/programEvents/$(request.resource.data.programEventId)).data;
    }

    // The ministry an anonymous submission lands in, which is what decides
    // whether the parish is collecting at all. Guarded by an `exists()` at the
    // call site for the same reason as above.
    //
    // This replaced a read of `submissionsOpen` on the *level* — see
    // `Program.submissionsOpen`. The flag moved up because the upload form did:
    // a visitor now picks any level in the ministry from a single picker, and a
    // flag per level made that picker a list with unexplained holes in it.
    function submissionProgram() {
      return get(/databases/$(database)/documents/programs/$(request.resource.data.programId)).data;
    }

    match /programs/{programId} {
      allow read: if isPublished(resource.data) || adminsProgram(programId);
      // Creating and retiring a program is the superadmin's alone. A program
      // administrator runs what they were given; they do not mint new ones.
      allow create, delete: if hasRole('admin');
      // Name, description, cover, order — theirs to edit.
      allow update: if adminsProgram(programId);
    }

    match /programEvents/{programEventId} {
      allow read: if isPublished(resource.data)
        || adminsProgramEvent(resource.data.programId, programEventId);

      // Creating "Week 2 2027" is a statement about the program, so it takes a
      // program grant. `request.resource` rather than `resource`: on a create
      // there is no existing document to read the programId from.
      //
      // Nothing here checks `parentId`, and that is deliberate rather than
      // missing. This collection is a tree of arbitrary depth — every level is
      // one of these documents and `parentId` names the one above it — but the
      // *containment* that matters is `programId`, which is checked. A forged
      // `parentId` pointing into another ministry cannot smuggle a level into
      // that ministry's pages: every read filters `programId ==`, so a foreign
      // parent is simply absent from the tree that gets built and the level is
      // shown at the top of its own ministry (see `buildGalleryTree`). Checking
      // it properly would cost a `get()` on the parent for every write, to
      // prevent a mis-drawn page in one's own program.
      allow create: if adminsProgram(request.resource.data.programId);

      // Editing one — its description, where it sits, its layout, the pictures it
      // shows — is what an event-scoped volunteer was given the event for.
      //
      // Changing `programId` is a different act, and is checked differently.
      // Re-filing an event under another program is a statement about both
      // programs, so it takes a grant on both, at program level. Checking the
      // destination with `adminsProgramEvent` here would be no check at all:
      // the writer's grant on *this event* satisfies it whichever program the
      // event is moved into, which is precisely the escalation it was meant to
      // stop. tests/rules/program-galleries.test.ts caught that; the compile
      // check did not.
      allow update: if adminsProgramEvent(resource.data.programId, programEventId)
        && (request.resource.data.programId == resource.data.programId
            || (adminsProgram(resource.data.programId)
                && adminsProgram(request.resource.data.programId)));

      allow delete: if adminsProgram(resource.data.programId);
    }

    match /galleryMedia/{mediaId} {
      /*
       * Public reads are approved-only, and the client must say so in the
       * query.
       *
       * This is decision #10 again, in a collection where getting it wrong is
       * worse: a list query is evaluated against the documents it *could*
       * return, so `where('programEventId','==',x)` alone cannot prove that
       * nothing pending comes back, and Firestore denies the whole query. Every
       * public read therefore carries `where('status','==','approved')`, which
       * proves it. tests/rules covers exactly this — a compile check cannot.
       */
      allow read: if resource.data.status == 'approved'
        || adminsProgramEvent(resource.data.programId, resource.data.programEventId);

      /*
       * Anonymous submission. Open on purpose, and narrow on purpose.
       *
       * There is no account behind this — a parishioner with camp photographs
       * has no reason to have one — so every constraint that would normally
       * come from knowing who somebody is has to be spelled out as a shape the
       * document must have. A submission may only ever arrive pending, placed
       * nowhere, laid out nowhere, and unreviewed. Anything else is somebody
       * trying to publish straight past the queue.
       *
       * `submissionsOpen` costs a document read on an unauthenticated write,
       * which is the price of the flag meaning anything at all. Without it,
       * closing submissions on a three-year-old gallery would be a UI
       * suggestion.
       */
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.renditionPath == null
        && request.resource.data.layout == null
        && request.resource.data.placement.onPage == false
        && request.resource.data.placement.slideshow == false
        && request.resource.data.placement.homepage == false
        && request.resource.data.caption == ''
        && request.resource.data.kind in ['photo', 'video']
        /*
         * The file this document claims. Constrained to the quarantine folder
         * for *this event*, and that is not tidiness.
         *
         * `sourcePath` is what the transcode Function copies into the public
         * `galleries/` bucket on approval, using the Admin SDK — which bypasses
         * storage.rules entirely and will fetch whatever it is pointed at. An
         * unconstrained path therefore means an anonymous stranger chooses
         * which object in the bucket gets published, including somebody else's
         * un-reviewed submission, which is the one prefix that is not otherwise
         * readable.
         *
         * Split rather than a regex: `programEventId` would be interpolated
         * into the pattern, and a document id is not a safe thing to paste into
         * a regular expression. The size check also proves the id contains no
         * slash of its own.
         */
        && request.resource.data.sourcePath.split('/').size() == 3
        && request.resource.data.sourcePath.split('/')[0] == 'submissions'
        && request.resource.data.sourcePath.split('/')[1] == request.resource.data.programEventId
        && exists(/databases/$(database)/documents/programEvents/$(request.resource.data.programEventId))
        // `programId` is denormalised onto every item so the approval queue and
        // the homepage band can filter without a join. Denormalised, and
        // therefore forgeable: unchecked, a submitter picks which program's
        // queue their upload lands in, and a photograph sent to Summercamp
        // surfaces for the St. Simon lead to approve into the wrong gallery.
        && request.resource.data.programId == submissionTarget().programId
        /*
         * Is the parish collecting at all.
         *
         * One flag on the ministry, not on the level — see
         * `Program.submissionsOpen`. Defaulting to `true` when the field is
         * absent is deliberate and is the one place in this file where a missing
         * field permits rather than denies: every program document written
         * before the field existed has no value for it, and reading absence as
         * "closed" would refuse every upload the parish receives until somebody
         * hand-wrote a field onto five documents. That is decision #10's failure
         * mode — a policy that compiles, passes, and denies everything real.
         *
         * The flag's job is to turn a deliberately-public surface *off*, and
         * every other constraint above still applies to what comes through it:
         * pending, unplaced, uncaptioned, and quarantined.
         *
         * `Program.submissionsOpen` documents the same default. If one changes,
         * both change; tests/rules/program-galleries.test.ts covers both sides.
         */
        && exists(/databases/$(database)/documents/programs/$(request.resource.data.programId))
        && submissionProgram().get('submissionsOpen', true) == true;

      // Approving, filing, captioning, laying out, rejecting. The one thing a
      // submitter cannot do to their own upload is anything at all — they have
      // no identity to match against, so there is nobody to grant it to.
      //
      // Filing is a write to `programEventId` now — moving a photograph to
      // another level of the tree — rather than to a `groupId` beside it. Note
      // what that means for an *event-scoped* grant: it is checked against the
      // level the photograph is on **before** the write, so a volunteer given one
      // week can move a photograph out of it and cannot move it back. That is
      // the right way round of the two: the alternative check, on the
      // destination, would let a grant on one day pull the whole ministry's
      // photographs into it. Program-scoped grants, which is what these
      // volunteers are normally given, are unaffected.
      allow update, delete: if adminsProgramEvent(resource.data.programId, resource.data.programEventId);
    }

    // Anything not matched above is denied. Adding a collection means adding a
    // rule here on purpose, rather than inheriting an accidental allow.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
