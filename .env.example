# =============================================================================
# SPSM — environment template.  Copy to .env and fill in:  cp .env.example .env
# =============================================================================
# This file is COMMITTED and must never contain a real value. It mirrors the
# names in .env, which is gitignored.
#
#   [public]  ships in the browser bundle by design. Not a secret.
#   [secret]  never commit, never prefix with NEXT_PUBLIC_. Production values
#             belong in Secret Manager.
#
# `REPLACE_ME` is treated as *absent* by packages/shared/src/config.ts, so a
# half-filled file fails loudly with the exact missing names.
#
# `npm run dev` reads the REAL Firestore, not the emulators — nothing calls
# connectFirestoreEmulator. So the six NEXT_PUBLIC_FIREBASE_* values below are
# required, or every page renders its "Firebase isn't configured" empty state.
# The emulators (`npm run dev:backend`) are for rules and Functions work only.
# See docs/local-dev.md. Full commentary lives in .env and docs/api-keys.md.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. SPSM FIREBASE  —  our own project. Read/write, the app's primary backend.
# -----------------------------------------------------------------------------
# Firebase console > Project settings > General > Your apps > SDK setup.
# [public] The API key is an identifier, not a credential. firestore.rules is
# what protects the data; App Check is what restricts the client.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_ME.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_ME
# [public] Optional — only if you enable Analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# [public] App Check debug token, local development only. Never set in prod.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# [public] reCAPTCHA Enterprise site key for App Check in production.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=


# -----------------------------------------------------------------------------
# 2. WEEKLY ANNOUNCEMENTS  —  separate Firebase project.  ***READ ONLY***
# -----------------------------------------------------------------------------
# Read-only is enforced by IAM on THAT project, not by this config and not by
# our code. Use a dedicated service account with the custom role in
# infra/iam/announcements-reader.yaml — never the default firebase-adminsdk
# account, which is effectively an editor. Verify with `npm run verify:scopes`.
# -----------------------------------------------------------------------------
ANNOUNCEMENTS_PROJECT_ID=
# Firestore collection holding the announcements.
ANNOUNCEMENTS_COLLECTION_PATH=
# Only if that project uses a non-default named Firestore database.
ANNOUNCEMENTS_DATABASE_ID=
# [secret] Full service-account JSON on ONE line (contents, not a path).
# Production: npx firebase functions:secrets:set ANNOUNCEMENTS_SERVICE_ACCOUNT
ANNOUNCEMENTS_SERVICE_ACCOUNT=


# -----------------------------------------------------------------------------
# 3. TAKSIS  —  separate Firebase project.  ***WRITE ONLY***
# -----------------------------------------------------------------------------
# We push pending vehicle registrations in; we must not be able to read Taksis's
# data. Enforcement is an IAM custom role on the Taksis project
# (datastore.entities.create only) — NOT anything in our code.
#
# LIVE since Aug 25 2026. `/parking` and `/forms/vehicle-registration` write here
# and nowhere else; there is no local copy, so an outage is reported to the
# person filling in the form rather than queued. Unset TAKSIS_SERVICE_ACCOUNT and
# vehicle registration answers 503 with a sentence rather than failing obscurely.
#
# The backend is Firestore, confirmed. The rtdb branch below is kept only so a
# wrong value fails loudly instead of writing documents nobody reads.
# -----------------------------------------------------------------------------
TAKSIS_PROJECT_ID=
# One of: firestore | rtdb. Firestore is the confirmed answer; rtdb is refused.
TAKSIS_BACKEND=firestore
# Collection path for pending vehicles. Top-level, no leading slash.
TAKSIS_PENDING_VEHICLES_PATH=pending_registrations
# Only for rtdb. e.g. https://<project>.firebaseio.com
TAKSIS_DATABASE_URL=
# [secret] Full service-account JSON on ONE line.
# Production: npx firebase functions:secrets:set TAKSIS_SERVICE_ACCOUNT
TAKSIS_SERVICE_ACCOUNT=


# -----------------------------------------------------------------------------
# 3b. BREEZE ChMS API  —  form import.  ***READ ONLY, and optional***
# -----------------------------------------------------------------------------
# Only the "Import" tab of the forms drawer uses these. Everything else in the
# forms feature works without them; unset, the two Breeze Functions answer 503
# with a sentence telling staff what to add.
#
# What it is for: copying a Breeze form's questions across as a native draft, so
# nobody retypes them. It is an IMPORT, not a mirror — Breeze's forms API is read
# and delete only, with no endpoint that creates an entry, so a Breeze form
# rendered natively would collect answers Breeze never hears about.
#
# TREAT THE KEY AS HIGHLY SENSITIVE. It reads the whole member database —
# addresses, giving records, everyone's contact details — and Breeze offers no
# way to scope it. It must never reach a browser, which is why the two Functions
# exist instead of the page calling Breeze directly.
#
# Where to get it: in Breeze, your name (top right) -> Account Settings ->
# Extensions -> API. Needs admin rights on the Breeze account.
# -----------------------------------------------------------------------------
# The subdomain in stphilopaterstmina.breezechms.com. Not a secret.
BREEZE_SUBDOMAIN=
# [secret] Production: npx firebase functions:secrets:set BREEZE_API_KEY
#
# NOTE: in production this secret must EXIST even when there is no key yet, and
# it is currently set to the literal `unset`. `firebase deploy` resolves every
# declared secret during discovery, so a missing one blocks the deploy of every
# unrelated function — `--only functions:formSubmit` fails on it too. The code
# treats `unset` exactly as it treats absent: the two Breeze endpoints answer
# 503 and nothing else is affected. See functions/src/forms/breeze.ts.
BREEZE_API_KEY=

# -----------------------------------------------------------------------------
# 4. SQUARE  —  bookstore payments.
# -----------------------------------------------------------------------------
# Square Developer Dashboard > your app > Credentials. Sandbox and production
# are two separate credential sets; only ever keep sandbox values locally.
# A personal access token has full account access and cannot be narrowed —
# least-privilege requires Square's OAuth flow with explicit scopes.
# -----------------------------------------------------------------------------
# One of: sandbox | production
SQUARE_ENVIRONMENT=sandbox
# [secret] Authorizes charges. Production value -> Secret Manager, never here.
SQUARE_ACCESS_TOKEN=REPLACE_ME
SQUARE_LOCATION_ID=REPLACE_ME
# [secret] Verifies inbound webhook signatures. Without it, anyone who finds the
# webhook URL can mark orders paid. Blank until you create the subscription.
SQUARE_WEBHOOK_SIGNATURE_KEY=REPLACE_ME
# [public] The three values the Web Payments SDK needs in the browser. None is a
# secret — they are visible in the network tab of any site using the SDK and
# authorize nothing on their own; the token that authorizes charges stays in the
# Functions runtime.
#
# All three must agree with each other AND with the Function's SQUARE_ENVIRONMENT
# and SQUARE_LOCATION_ID. The card token is minted by one environment's SDK and
# spent by the Function against another's API, so a mismatch is rejected as an
# invalid source id — which reads like a card problem, not a config one.
# Sandbox application ids are prefixed `sandbox-`; sandbox and production have
# different location ids.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# sandbox | production. Omit and it is inferred from the application id prefix.
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox


# -----------------------------------------------------------------------------
# 5. TITHE.LY  —  giving, recurring schedules, ChMS.
# -----------------------------------------------------------------------------
# Access is by request: email support@tithe.ly, then generate keys at
# https://tithe.ly/api-setup. Requires both a test and a live Tithe.ly account;
# live keys are issued separately at go-live.
#
# Two products, two credential systems (5a and 5b). Forms are in neither — see
# 5c. Full commentary in .env.
# -----------------------------------------------------------------------------
# [public] The parish's existing Tithe.ly giving page. Needs no API access.
NEXT_PUBLIC_TITHELY_GIVING_URL=

# --- 5a. Giving API -----------------------------------------------------------
#   test  https://tithelydev.com/api/v1/    live  https://tithe.ly/api/v1/
# Transactions carry a `recurring` param (start_date + term) — scheduled giving.
# One of: test | live
TITHELY_ENVIRONMENT=test
# [public] Used by tithely.js in the browser to tokenize a card.
NEXT_PUBLIC_TITHELY_PUBLIC_KEY=
# [secret] Cloud Functions only. Never prefix with NEXT_PUBLIC_.
# Production: npx firebase functions:secrets:set TITHELY_PRIVATE_KEY
TITHELY_PRIVATE_KEY=
TITHELY_ORGANIZATION_ID=

# --- 5b. ChMS (Elvanto) API ---------------------------------------------------
# Only if the parish is on Tithely ChMS. Base https://api.elvanto.com/v1/; the
# key goes in the HTTP Basic *username* field, password blank/dummy.
# Elvanto > hover your name > Settings > Integrations. Regenerating it breaks
# any existing Tithely<->Elvanto link.
# [secret]
TITHELY_CHMS_API_KEY=
# [secret] OAuth2 alternative to the key above. Use one or the other.
TITHELY_CHMS_OAUTH_CLIENT_ID=
TITHELY_CHMS_OAUTH_CLIENT_SECRET=

# --- 5c. Forms — no API exists ------------------------------------------------
# Neither the Giving API nor the Elvanto API exposes a forms resource. Embed or
# link only; build form data natively against our Firestore. No variable here.


# -----------------------------------------------------------------------------
# 6. MICROSOFT ENTRA ID  —  staff/servant auth.
# -----------------------------------------------------------------------------
# [public] Tenant and client id only. The client SECRET goes in the Firebase
# console's Microsoft provider config, not in this file.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_CLIENT_ID=


# -----------------------------------------------------------------------------
# PRAYER_KEY  —  sealing prayer requests.  ***THE ONE YOU CANNOT LOSE***
# -----------------------------------------------------------------------------
# 32 random bytes, base64. Prayer request bodies, names and contact addresses are
# stored as AES-256-GCM envelopes keyed from this. Firestore holds ciphertext.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   npx firebase functions:secrets:set PRAYER_KEY
#
# LOSING OR ROTATING THIS ORPHANS EVERY REQUEST SEALED UNDER THE OLD VERSION.
# Secret Manager keeps old versions, so recovery means decrypting with the
# previous one — but nothing falls back automatically, deliberately: silently
# trying an older key would hide the fact that a rotation had happened.
#
# It is NOT in this file and must never be. Production is Secret Manager only;
# functions/.env.local holds a DIFFERENT key for the emulator, so a laptop
# cannot decrypt anything a parishioner actually sent.
#
# What this does and does not protect, stated plainly because the submission UI
# says it too: it stops a Firestore console admin, a database export, a leaked
# backup, or a mistaken rules edit from yielding anything readable. It does NOT
# stop whoever holds the Functions service account — clergy must be able to read
# these, so a key has to exist somewhere a server can reach.
# See docs/decisions.md #1, which this supersedes.
# -----------------------------------------------------------------------------
PRAYER_KEY=

# -----------------------------------------------------------------------------
# PLACEHOLDER SECRETS — read this before wondering why a key says `unset`
# -----------------------------------------------------------------------------
# `firebase deploy` resolves EVERY secret declared anywhere in functions/src
# during its discovery step, not just those belonging to the functions being
# deployed. One missing secret therefore blocks every deploy, including
# `--only functions:<something-unrelated>`.
#
# Two secrets are consequently set to the literal string `unset` in Secret
# Manager rather than left absent:
#
#   BREEZE_API_KEY   — the forms importer. breeze.ts treats `unset` exactly as
#                      absent and answers 503, so this is inert and safe.
#   YOUTUBE_API_KEY  — the livestream's /api/live. **This one is NOT handled in
#                      code.** It exists only so other functions can deploy. The
#                      `live` function is not deployed; before deploying it, set
#                      a real key or /api/live will fail against a bogus one.
#
# Replacing either is an ordinary `firebase functions:secrets:set <NAME>` — the
# new version supersedes the placeholder and no code change is needed.
# -----------------------------------------------------------------------------
