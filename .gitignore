# =============================================================================
# Secrets
# =============================================================================
# Deny-by-default. Every .env is ignored and the template is added back by
# name, so a new .env.production or .env.staging is safe the moment it exists
# rather than the moment someone remembers to add a rule here.
.env*
!.env.example

# Service-account keys and certificates, matched by shape rather than by the
# specific names we happen to have used. gcloud will name a downloaded key
# whatever you ask it to.
*-key.json
*-sa.json
*-credentials.json
*-service-account*.json
serviceAccountKey.json
*.pem
*.p8
*.p12
*.pfx
*.keystore

# Emulator secret values. Committing this is how a real token leaks by accident.
.secret.local
# Legacy Cloud Functions runtime config; can contain tokens.
.runtimeconfig.json

# =============================================================================
# Build output and dependencies
# =============================================================================
node_modules/
dist/
out/
.next/
# The second dev server's output — see `dev:emulated:second` in
# apps/website/package.json. A separate directory is what lets it run alongside
# a server already using .next/.
.next-emulated/
# The spare server's output dir — see .claude/launch.json's -3200 entry. A peer
# session working in this same tree often already holds :3100.
.next-emulated-3200/
.next-real-3300/
.next-real-3400/
.next-real-3500/
.next-real-3600/
.next-real-3700/
.next-real-3800/
.turbo/
coverage/
*.tsbuildinfo

# The esbuild bundle for Cloud Functions. Anchored to that one directory on
# purpose: a bare `lib/` also matches apps/website/src/lib, which is source.
/functions/lib/

# =============================================================================
# Firebase
# =============================================================================
.firebase/
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
pubsub-debug.log
dataconnect-debug.log

# =============================================================================
# Logs and editors
# =============================================================================
*.log
npm-debug.log*
yarn-error.log*
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# =============================================================================
# OS
# =============================================================================
.DS_Store
._*
Thumbs.db

# Where `next dev --experimental-https` writes its self-signed cert. The *.pem
# rule above already catches the key itself; this covers the directory.
apps/website/certificates/
